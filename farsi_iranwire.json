    {
      "id": 90254,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93BB.png\u0026#39;)\"\u003e\u003cb\u003e📻\u003c/b\u003e\u003c/i\u003e نسخه کامل برنامه شبانگاهی رادیو ایران‌وایر - سه‌شنبه ۲۹ اردیبهشت\u003cbr/\u003e\u003cbr/\u003eدر دو نوبت به وقت ایران، ساعت ۱۴ تا ۱۵ روی موج کوتاه ۱۵۵۰۰ کیلوهرتز\u003cbr/\u003eو ساعت ۲۳ تا ۲۴ روی موج کوتاه ۹۷۷۰ کیلوهرتز در داخل ایران با شما هستیم.\u003cbr/\u003eهمین‌طور از طریق وب‌سایت و شبکه‌های اجتماعی در چهارگوشه جهان.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Farsi_Iranwire\" target=\"_blank\"\u003e@Farsi_Iranwire\u003c/a\u003e",
      "date": "2026-05-19T19:31:54Z",
      "edited": false,
      "edit_date": "0001-01-01T00:00:00Z",
      "views": 1850,
      "forwards": 0,
