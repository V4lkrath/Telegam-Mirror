    {
      "id": 10844,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93B9.png\u0026#39;)\"\u003e\u003cb\u003e📹\u003c/b\u003e\u003c/i\u003eویدئویی نشان می‌دهد که یکی از دو پهپادِ حزب‌الله صبح امروز به یک منطقه نظامی اسرائیل در مرز لبنان در جلیل غربی اصابت کرده است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/mwarmonitor\" target=\"_blank\"\u003e@mwarmonitor\u003c/a\u003e",
