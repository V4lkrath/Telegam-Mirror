    },
    {
      "id": 11303,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B4.png\u0026#39;)\"\u003e\u003cb\u003e🔴\u003c/b\u003e\u003c/i\u003eمقامات روسیه از ساعت ۹ صبح امروز، فروش سوخت به عموم مردم در کریمه را متوقف کرده‌اند. این تصمیم پس از حملات شبانه اوکراین به بنادر و زیرساخت‌های نفتی کلیدی اتخاذ شده است.\u003cbr/\u003e\u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B8.png\u0026#39;)\"\u003e\u003cb\u003e🔸\u003c/b\u003e\u003c/i\u003eبر اساس این گزارش، از این پس عرضه سوخت فقط به خدمات اضطراری و نیروهای امنیتی محدود خواهد بود تا تداوم عملیات حیاتی حفظ شود.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/mwarmonitor\" target=\"_blank\"\u003e@mwarmonitor\u003c/a\u003e",
      "date": "2026-06-21T08:21:23Z",
      "edited": false,
      "edit_date": "0001-01-01T00:00:00Z",
      "views": 3050,
      "forwards": 0,
      "replies": 0,
