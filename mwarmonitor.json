    {
      "id": 10060,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B4.png\u0026#39;)\"\u003e\u003cb\u003e🔴\u003c/b\u003e\u003c/i\u003eیک نفتکش بسیار بزرگ (VLCC) برای نخستین بار طی چهار هفته گذشته در جزیره خارک در ایران در حال بارگیری نفت خام است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/mwarmonitor\" target=\"_blank\"\u003e@mwarmonitor\u003c/a\u003e",
      "date": "2026-06-02T23:34:03Z",
