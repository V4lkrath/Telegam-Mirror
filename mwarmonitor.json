    {
      "id": 10676,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B8.png\u0026#39;)\"\u003e\u003cb\u003e🔸\u003c/b\u003e\u003c/i\u003eمسئول امنیتی اسرائیلی: اسرائیل تاکنون در حملات علیه ایران مشارکت نداشته است. شبکه کان اسرائیل \u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/mwarmonitor\" target=\"_blank\"\u003e@mwarmonitor\u003c/a\u003e",
      "date": "2026-06-10T22:17:53Z",
