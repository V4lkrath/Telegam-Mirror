    {
      "id": 11305,
      "message": "RAF Royal Air Force / USAF United States Air Force\u003cbr/\u003e\u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29C88.png\u0026#39;)\"\u003e\u003cb\u003e✈️\u003c/b\u003e\u003c/i\u003eهواپیماهای سوخت‌رسان Airbus KC.2 Voyager (۲ فروند)\u003cbr/\u003e43C6F6 ZZ333 - پرواز ASCOT 2228\u003cbr/\u003e43C6F5 ZZ332 - پرواز ASCOT 2226\u003cbr/\u003e\u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29C88.png\u0026#39;)\"\u003e\u003cb\u003e✈️\u003c/b\u003e\u003c/i\u003eهواپیماهای Boeing KC-46 Pegasus (۲ فروند)\u003cbr/\u003eAF8403 22-46099 - پرواز REACH 286\u003cbr/\u003eAED489 22-46102 - پرواز REACH 273\u003cbr/\u003e\u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B4.png\u0026#39;)\"\u003e\u003cb\u003e🔴\u003c/b\u003e\u003c/i\u003eچند جابه‌جایی هواپیمای سوخت‌رسان صبح امروز انجام شده است. دو فروند Voyager نیروی هوایی بریتانیا از پایگاه RAF Brize Norton برخاسته و از آسمان فرانسه عبور کرده‌اند و مقصدشان نامشخص است.\u003cbr/\u003e\u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29C88.png\u0026#39;)\"\u003e\u003cb\u003e✈️\u003c/b\u003e\u003c/i\u003eهمچنین دو فروند KC-46 از پایگاه McConnell AFB در حال حرکت به سمت پایگاه العُدید (Al Udeid) از طریق Lajes Field هستند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/mwarmonitor\" target=\"_blank\"\u003e@mwarmonitor\u003c/a\u003e",
