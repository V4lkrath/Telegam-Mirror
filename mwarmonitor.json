        {
          "type": "photo",
          "url": "https://cdn4.telesco.pe/file/lxre9d0H7io5Dsxck88QXKt85UpNZPjxCoTYtqZ5mGEJ-H4RurLG4PYlRYZ_dbo8jCL8VZ4Lji4nQCu19_MX0FsuAN7-9vgf99XRw-lb7u2IML2hOqcijYga-N5aKLS8D9w6Dk8nZgVHiLHSZ7EryMcTAtvhzh0KMbbcY0JfxTOx9soHSR1NOGKa5rX6lM0Tt-mSfHUqQIrHA4uIxtZs0pYGW1uWJMWjnntP7ZHMUfxHjmP88KyBlvaMizbfqG5fnH044wvkUVBsnOOuK10qRHu0CKapJcZz_YCgOFYBRiQqUgQuRI0_lrSfGp7rpKwKNWLTe45HvWdr1WIuk4fxtw.jpg"
