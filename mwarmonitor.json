    },
    {
      "id": 10805,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93B0.png\u0026#39;)\"\u003e\u003cb\u003e📰\u003c/b\u003e\u003c/i\u003e بلومبرگ:\u003cbr/\u003eایران به‌احتمال زیاد در جریان آتش‌بس، سلاح‌های پیشرفته روسی را به ذخایر تسلیحاتی خود اضافه کرده است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/mwarmonitor\" target=\"_blank\"\u003e@mwarmonitor\u003c/a\u003e",
      "date": "2026-06-13T08:21:41Z",
