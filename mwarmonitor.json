    },
    {
      "id": 9468,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B4.png\u0026#39;)\"\u003e\u003cb\u003e🔴\u003c/b\u003e\u003c/i\u003e منبع پاکستانی به الجزیره:\u003cbr/\u003e«آمریکا و ایران درگیر و اسیر مواضع سخت‌گیرانه و سقف‌های بالای خواسته‌های خود درباره اورانیوم، بستن تنگه هرمز و محاصره بنادر هستند.»\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/mwarmonitor\" target=\"_blank\"\u003e@mwarmonitor\u003c/a\u003e",
      "date": "2026-05-22T10:15:03Z",
