    {
      "id": 285860,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BB.png\u0026#39;)\"\u003e\u003cb\u003e🔻\u003c/b\u003e\u003c/i\u003eپزشکیان، قالیباف و فرزند بزرگ علی‌ خامنه‌ای در مراسم تشییع او در عراق شرکت می‌کنند\u003cbr/\u003e\u003cbr/\u003eبه گزارش خبرگزاری مهر، تابوت علی خامنه‌ای فردا پس از تشییع در قم به نجف منتقل خواهد شد.\u003cbr/\u003e\u003cbr/\u003eبنابر این گزارش، مصطفی خامنه‌ای، فرزند بزرگ رهبر سابق جمهوری اسلامی، مسعود پزشکیان و محمدباقر قالیباف، رئیس‌جمهور و رئیس مجلس ایران، هم فردا به نجف می‌روند و در مراسم تشییع در عراق حضور خواهند داشت.\u003cbr/\u003e\u003cbr/\u003eمراسم تشییع علی خامنه‌ای قرار است روز چهارشنبه در شهرهای کربلا و نجف در عراق برگزار شود.\u003cbr/\u003e\u003cbr/\u003eرهبر سابق جمهوری اسلامی پنجشنبه در حرم امام رضا در مشهد به خاک سپرده خواهد شد.\u003cbr/\u003e\u003ca href=\"https://bbc.in/44NZZG8\" target=\"_blank\" rel=\"noopener\"\u003ehttps://bbc.in/44NZZG8\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/BBCPersian\" target=\"_blank\"\u003e@BBCPersian\u003c/a\u003e",
      "date": "2026-07-06T12:16:18Z",
      "edited": false,
      "edit_date": "0001-01-01T00:00:00Z",
      "views": 38500,
      "forwards": 0,
