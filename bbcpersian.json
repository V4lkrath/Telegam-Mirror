    {
      "id": 289215,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BB.png\u0026#39;)\"\u003e\u003cb\u003e🔻\u003c/b\u003e\u003c/i\u003eحمایت حماس از موضع دبیرشورای عالی امنیت ملی ایران برای پایان تمامی جنگ‌ها در منطقه\u003cbr/\u003e\u003cbr/\u003eگروه فلسطینی حماس از اظهارات اخیر محسن رضایی، دبیر تازه منصوب‌شده شورای عالی امنیت ملی ایران، استقبال کرده است.\u003cbr/\u003e\u003cbr/\u003eآقای رضایی روز سه‌شنبه در اظهاراتی خواستار «آتش‌بس در سراسر منطقه، از جمله در لبنان و غزه» شده بود و گفته بود که تنگه هرمز تا زمان برآورده شدن این شرایط، بسته باقی خواهد ماند.\u003cbr/\u003e\u003cbr/\u003eدفتر روابط عربی و اسلامی حماس در بیانیه‌ای اعلام کرد که پایان دادن به جنگ‌ها در راستای «منافع عالی منطقه، مردمان آن و آینده‌شان» است.\u003cbr/\u003e\u003cbr/\u003eاین گروه در ادامه گفته است که تداوم جنگ‌ها «تنها به نفع نقشه‌های» اسرائیل برای منطقه است که «برنامه‌هایی بر پایه از هم گسیختن، بی‌ثبات‌سازی و تحلیل بردن منابع» آن دارد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://bbc.in/4wJUc09\" target=\"_blank\" rel=\"noopener\"\u003ehttps://bbc.in/4wJUc09\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/BBCPersian\" target=\"_blank\"\u003e@BBCPersian\u003c/a\u003e",
      "date": "2026-08-13T07:13:40Z",
      "edited": false,
      "edit_date": "0001-01-01T00:00:00Z",
      "views": 20200,
      "forwards": 0,
      "replies": 0,
      "sender_id": 0,
      "sender_name": "BBCPersian"
    },
    {
      "id": 289216,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BB.png\u0026#39;)\"\u003e\u003cb\u003e🔻\u003c/b\u003e\u003c/i\u003eعراق از توقیف یک کارخانه ساخت پهپاد خبر داد\u003cbr/\u003e\u003cbr/\u003eخبرگزاری دولتی عراق به نقل از وزارت کشور این کشور اعلام کرد که ۲۰ فروند پهپاد ساخت داخل را توقیف و چهار نفر را در این رابطه بازداشت کرده است.\u003cbr/\u003e\u003cbr/\u003eاین وزارتخانه در بیانیه‌ای اعلام کرد که «آنها در جریان بازجویی اعتراف کردند که این پهپادها را با هدف قاچاق در اختیار داشته‌اند.»\u003cbr/\u003e\u003cbr/\u003eوزارت کشور عراق یا خبرگزاری دولتی این کشور جزییات بیشتر و اینکه آیا دستگیر شدگان وابسته به گروه‌های شبه‌نظامی هستند یا نه را اعلام نکرده است.\u003cbr/\u003e\u003cbr/\u003eدولت عراق اعلام کرده است که بغداد برای تقویت تدابیر امنیتی خود تلاش می‌کند و اجازه نخواهد داد تا از خاک یا حریم هوایی این کشور برای انجام حملات علیه کشورهای همسایه استفاده شود.\u003cbr/\u003e\u003cbr/\u003eچند هفته پیش حملاتی به خاک عربستان سعودی انجام شد که ریاض گفت از خاک عراق این حملات صورت گرفته و در پاسخ نیروهای حشد شعبی را در خاک عراق هدف قرار داد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://bbc.in/4wJUc09\" target=\"_blank\" rel=\"noopener\"\u003ehttps://bbc.in/4wJUc09\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/BBCPersian\" target=\"_blank\"\u003e@BBCPersian\u003c/a\u003e",
