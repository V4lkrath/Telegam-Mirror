    {
      "id": 284690,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BB.png\u0026#39;)\"\u003e\u003cb\u003e🔻\u003c/b\u003e\u003c/i\u003eپوشش زنده ...\u003cbr/\u003e\u003cbr/\u003eبه پوشش زنده ما از آخرین اخبار ایران و جهان در روز دوشنبه اول تیر / ۲۲ ژوئن خوش آمدید.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://bbc.in/4w38UPQ\" target=\"_blank\" rel=\"noopener\"\u003ehttps://bbc.in/4w38UPQ\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/BBCPersian\" target=\"_blank\"\u003e@BBCPersian\u003c/a\u003e",
