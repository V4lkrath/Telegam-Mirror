    {
      "id": 289376,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BB.png\u0026#39;)\"\u003e\u003cb\u003e🔻\u003c/b\u003e\u003c/i\u003eزمین‌لرزه‌ قدرتمندی در آب‌های نزدیک جزیره فلورس اندونزی به وقوع پیوسته است.\u003cbr/\u003e\u003cbr/\u003eسازمان زمین‌شناسی آمریکا شدت این زمین‌لرزه را ۷/۷ اعلام کرده و مقام‌های اندونزی درباره احتمال وقوع سونامی هشدار داده‌اند.\u003cbr/\u003e\u003cbr/\u003eتا این لحظه گزارشی از خسارت یا تلفات منتشر نشده است.\u003cbr/\u003e\u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93B7.png\u0026#39;)\"\u003e\u003cb\u003e📷\u003c/b\u003e\u003c/i\u003e Reuters\u003cbr/\u003e\u003ca href=\"https://t.me/BBCPersian\" target=\"_blank\"\u003e@BBCPersian\u003c/a\u003e",
