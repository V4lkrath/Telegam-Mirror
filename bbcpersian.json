    {
      "id": 284581,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BB.png\u0026#39;)\"\u003e\u003cb\u003e🔻\u003c/b\u003e\u003c/i\u003eعباس عراقچی در محل مذاکرات با آمریکا با وزیر خارجه سوئیس دیدار کرد\u003cbr/\u003e\u003cbr/\u003eدر نخستین برنامه رسمی هیات ایرانی در سوئیس، عباس عراقچی، وزیر امور خارجه ایران در هتل بورگن‌اشتوک سوئیس، با ایگناتسیو کاسیس، وزیر امور خارجه این کشور دیدار و گفت‌وگو کرد.\u003cbr/\u003e\u003cbr/\u003eاین دیدار در حاشیه مذاکرات ایران و آمریکا در سوئیس برگزار شد و حدود ۴۵ دقیقه ادامه داشت.\u003cbr/\u003e\u003cbr/\u003eدر حال حاصر هیئت‌های ایران، آمریکا و پاکستان و قطر قرار است امروز یک دیدار چهارجانبه برگزار میکنند.\u003cbr/\u003e\u003cbr/\u003eهنوز جزئیات دقیقی از برنامه‌ریزی مذاکرات منتشر نشده است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://bbc.in/4vX0xFb\" target=\"_blank\" rel=\"noopener\"\u003ehttps://bbc.in/4vX0xFb\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/BBCPersian\" target=\"_blank\"\u003e@BBCPersian\u003c/a\u003e",
