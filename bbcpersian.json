    {
      "id": 284656,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29ABD.png\u0026#39;)\"\u003e\u003cb\u003e⚽️\u003c/b\u003e\u003c/i\u003eاخراج بازیکن بلژیک\u003cbr/\u003e\u003cbr/\u003eناتان انگوی، مدافع ۲۳ ساله بلژیک به دلیل خطا روی مهدی طارمی و گرفتن یک موقعیت مسلم گل از ایران اخراج شد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://bbc.in/4eGn7uR\" target=\"_blank\" rel=\"noopener\"\u003ehttps://bbc.in/4eGn7uR\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/BBCPersian\" target=\"_blank\"\u003e@BBCPersian\u003c/a\u003e",
