    {
      "id": 282628,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BB.png\u0026#39;)\"\u003e\u003cb\u003e🔻\u003c/b\u003e\u003c/i\u003eبازار جهانی نفت با روند نزولی آغاز به کار کرد\u003cbr/\u003e\u003cbr/\u003eقیمت نفت در معاملات ابتدایی امروز در بازارهای جهانی با روند نزولی شروع به کار کرد.\u003cbr/\u003e\u003cbr/\u003eاین بازار همچنان نسبت به پیشرفت در مذاکرات صلح ایالات متحده و ایران محتاط است.\u003cbr/\u003e\u003cbr/\u003eقیمت معاملات آتی نفت خام برنت با ۷۵ سنت یا ۰/۷۹ درصد کاهش به ۹۴/۲۳ دلار در هر بشکه رسید، در حالی که بهای نفت خام وست تگزاس اینترمدیت آمریکا با ۸۵ سنت یا ۰/۹۲ درصد کاهش به ۹۱/۳۱ دلار در هر بشکه رسید.\u003cbr/\u003e\u003cbr/\u003eدونالد ترامپ در گفتگو با ای‌بی‌سی گفته است از نظر او توافق با ایران که جزییات آن در حال تکمیل شدن است «هفته آینده» به نتیجه خواهد رسید.\u003cbr/\u003e\u003cbr/\u003eاو گفته در گفتگو با بنیامین نتانیاهو وحزب‌الله خواستار توقف حملات آنها شده است.\u003cbr/\u003e\u003cbr/\u003eسفارت لبنان در آمریکا هم تایید کرده که حزب‌الله با توقف درگیری با اسرائیل موافقت کرده است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://bbc.in/4x4rB6K\" target=\"_blank\" rel=\"noopener\"\u003ehttps://bbc.in/4x4rB6K\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/BBCPersian\" target=\"_blank\"\u003e@BBCPersian\u003c/a\u003e",
