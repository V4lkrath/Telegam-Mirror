    },
    {
      "id": 287358,
      "message": "\u003cb\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BB.png\u0026#39;)\"\u003e\u003cb\u003e🔻\u003c/b\u003e\u003c/i\u003eسپاه تهران گزارش‌ها درباره فعالیت سامانه‌های پدافندی در پاکدشت تهران را رد کرد\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eسپاه استان تهران می‌گوید که گزارش‌های منتشرشده در فضای مجازی درباره فعالیت سامانه‌های پدافندی و وقوع اصابت در پاکدشت، در بامداد امروز صحت ندارد.\u003cbr/\u003e\u003cbr/\u003eپیشتر رسانه‌های نزدیک به نیروهای نظامی تهران، با انتشار تصاویری گزارش دادند که پدافند تهران بار دیگر در شرق و غرب تهران بزرگ فعال شده است.\u003cbr/\u003e\u003cbr/\u003eاین اخبار همزمان با دور یازدهم حملات آمریکا منتشر شد.\u003cbr/\u003e\u003cbr/\u003eبنابر گزارش‌ها، شب گذشته آمریکا با گسترش حملات، نقاطی را در سیریک در نزدیکی بندرعباس در هرمزگان، چابهار و کنارک در سیستان‌وبلوچستان، بوشهر، بهبهان، امیدیه و ماهشهر در خوزستان، بانه در کردستان، کنگاوردر کرمانشاه، کبودرآهنگ در همدان، تبریز و ارومیه و مهاباد در آذربایجان شرقی و غربی هدف قرار داد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://bbc.in/4fukIUE\" target=\"_blank\" rel=\"noopener\"\u003ehttps://bbc.in/4fukIUE\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/BBCPersian\" target=\"_blank\"\u003e@BBCPersian\u003c/a\u003e",
      "date": "2026-07-22T11:03:08Z",
      "edited": false,
      "edit_date": "0001-01-01T00:00:00Z",
      "views": 9480,
      "forwards": 0,
