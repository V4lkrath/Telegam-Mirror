    {
      "id": 287710,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BB.png\u0026#39;)\"\u003e\u003cb\u003e🔻\u003c/b\u003e\u003c/i\u003eزمین‌لرزه‌ای به بزرگی ۴/۶ بردسیر در استان کرمان را لرزاند\u003cbr/\u003e\u003cbr/\u003eمرکز لرزه‌نگاری ایران اعلام کرده است که زمین‌لرزه‌ای به بزرگی ۴/۶ بامداد یکشنبه در حوالی بردسیر در استان کرمان به وقوع پیوست.\u003cbr/\u003e\u003cbr/\u003eاین زمین‌لرزه ساعت ۳:۴۶ و در عمق ۱۰ کیلومتری زمین ثبت شده است. کانون زلزله در نزدیکی بردسیر و در فاصله ۲۲ کیلومتری شهر نگار و ۳۶ کیلومتری شهر باغین بوده است.\u003cbr/\u003e\u003cbr/\u003eمدیرکل مدیریت بحران استانداری کرمان گفت که این زلزله خسارتی جانی و مالی نداشت.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://bbc.in/4hxm5V1\" target=\"_blank\" rel=\"noopener\"\u003ehttps://bbc.in/4hxm5V1\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/BBCPersian\" target=\"_blank\"\u003e@BBCPersian\u003c/a\u003e",
