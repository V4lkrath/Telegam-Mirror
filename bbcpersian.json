    {
      "id": 284526,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BB.png\u0026#39;)\"\u003e\u003cb\u003e🔻\u003c/b\u003e\u003c/i\u003eاستعفای یکی از مدیران شبکه خبر پس از اظهارات نبویان درباره مذاکره با آمریکا، منتسب به مجتبی خامنه‌ای\u003cbr/\u003e\u003cbr/\u003eدر پی اشارات محمود نبویان، نایب‌رئیس کمیسیون امنیت ملی مجلس شورای اسلامی، در یک برنامه زنده تلویزیونی به بخشی از مکاتبات محرمانه منتسب به مجتبی خامنه‌ای و بازخوانی آنها درباره مذاکرات ایران و آمریکا، صداوسیمای جمهوری اسلامی از پیگیری قانونی این موضوع خبر داد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://bbc.in/4w5ExZ6\" target=\"_blank\" rel=\"noopener\"\u003ehttps://bbc.in/4w5ExZ6\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/BBCPersian\" target=\"_blank\"\u003e@BBCPersian\u003c/a\u003e",
