    {
      "id": 287778,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BB.png\u0026#39;)\"\u003e\u003cb\u003e🔻\u003c/b\u003e\u003c/i\u003e تیراندازی در جشنواره غذا در سیاتل؛ چندین نفر مجروح شدند\u003cbr/\u003e\u003cbr/\u003eپلیس شهر سیاتل آمریکا در حال پاسخگویی به تیراندازی در محل برگزاری جشنواره بزرگ غذایی این شهر است که هر ساله صدها هزار نفر را جذب خود می‌کند.\u003cbr/\u003e\u003cbr/\u003eاین تیراندازی عصر یکشنبه حدود ساعت ۶ عصر به وقت کرانه غربی آمریکا روی داد و شاهدان عینی از شنیدن صدای چند شلیک خبر داده‌اند.\u003cbr/\u003e\u003cbr/\u003eهنوز هیچ گزارشی از تعداد مجروحان و این که تیرانداز دستگیر شده یا نه، منتشر نشده است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/BBCPersian\" target=\"_blank\"\u003e@BBCPersian\u003c/a\u003e",
