    {
      "id": 286864,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BB.png\u0026#39;)\"\u003e\u003cb\u003e🔻\u003c/b\u003e\u003c/i\u003e\u003cb\u003eاستانداری هرمزگان: شش پل در شهرستان خمیر هرمزگان هدف حملات آمریکا قرار گرفت\u003cbr/\u003e\u003c/b\u003e\u003cbr/\u003eاستانداری هرمزگان گفته است که بامداد جمعه «۶ پل در شهرستان خمیر» هدف حملات آمریکا قرار گرفته است.\u003cbr/\u003e\u003cbr/\u003eبراساس اعلام استانداری هرمزگان پل گریوه در مسیر بندرعباس، خمیر، لار\u003cbr/\u003e\u003cbr/\u003eپل بعد از روستای لاتیدان (کلمتلی) ؛ مسیر برگشت بندرعباس، خمیر، لار\u003cbr/\u003e\u003cbr/\u003eدو پل در مسیر کهورستان، لار\u003cbr/\u003e\u003cbr/\u003eپل نیمه کاره محور بندر خمیر، کشار، بندرعباس\u003cbr/\u003e\u003cbr/\u003eپل روستای مارو در شهرستان خمیر\u003cbr/\u003e\u003cbr/\u003eدر حملات امروز آمریکا آسیب دیده‌اند و از مردم درخواست شده که از تردد در این مناطق خودداری کنند.\u003cbr/\u003e\u003ca href=\"https://t.me/BBCPersian\" target=\"_blank\"\u003e@BBCPersian\u003c/a\u003e",
