    {
      "id": 283417,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BB.png\u0026#39;)\"\u003e\u003cb\u003e🔻\u003c/b\u003e\u003c/i\u003eسه نفر در تهران بر اثر حملات آمریکا مجروح شدند\u003cbr/\u003e\u003cbr/\u003eمقام های محلی در تهران از جراحت سه نفر در این استان بر اثر حملات امروز آمریکا خبر دادند.\u003cbr/\u003e\u003cbr/\u003eخبرگزاری ایسنا به نقل از رئیس اورژانس استان تهران این خبر را اعلام کرده است.\u003cbr/\u003e\u003cbr/\u003eدر حملات بامداد امروز آمریکا علاوه بر مناطقی در سواحل خلیج فارس، صدای انفجار ناشی از حملات هوایی احتمالی در اطراف تهران کرج، آبیک قزوین، ورامین و ملارد و اشتهارد گزارش شده است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://bbc.in/4v5B0d7\" target=\"_blank\" rel=\"noopener\"\u003ehttps://bbc.in/4v5B0d7\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/BBCPersian\" target=\"_blank\"\u003e@BBCPersian\u003c/a\u003e",
      "date": "2026-06-11T08:11:35Z",
      "edited": false,
      "edit_date": "0001-01-01T00:00:00Z",
