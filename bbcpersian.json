    {
      "id": 284153,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BB.png\u0026#39;)\"\u003e\u003cb\u003e🔻\u003c/b\u003e\u003c/i\u003eگزارش‌های جدیدی از حیات‌وحش ایران منتشر شده است از جمله تولد پنج توله جدید گور ایرانی در پارک ملی کویر سمنان و یا تصویر کره مرال قرمز در پناهگاه حیات وحش لوندویل آستارا.\u003cbr/\u003eگورخر و مرال در خطر انقراضند و در زیستگاه‌های مخصوص زیر نظر نگهداری می‌شوند.\u003cbr/\u003e\u003cbr/\u003eدر همین حال احتمال بی نتیجه بودن طرح افزایش جمعیت یوزپلنگ ایرانی پس از ۱۰ سال تلاش هم توجه‌ها را جلب کرده است.\u003cbr/\u003e\u003cbr/\u003eدر همین حال گزارش شده است که با افزایش خطر انقراض ماهیان خاویاری در دریای خزر به دلیل ساخت و ساز بی‌رویه و ورود پسماندهای خانگی و صنعتی، برای اولین بار پنج قطعه ماهی خاویاری با هدف احیا این گونه در دریای مازندران رها شده‌اند.\u003cbr/\u003e\u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F8EA5.png\u0026#39;)\"\u003e\u003cb\u003e🎥\u003c/b\u003e\u003c/i\u003eFARS/ IRNA\u003cbr/\u003e\u003ca href=\"https://t.me/BBCPersian\" target=\"_blank\"\u003e@BBCPersian\u003c/a\u003e",
