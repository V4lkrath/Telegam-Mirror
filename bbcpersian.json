    {
      "id": 287707,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BB.png\u0026#39;)\"\u003e\u003cb\u003e🔻\u003c/b\u003e\u003c/i\u003eاعتراض کیتی پری به استفاده کاخ سفید از ترانه «فایروُرک» در ویدیوی حمله به ایران\u003cbr/\u003e\u003cbr/\u003eکیتی پری، خواننده آمریکایی، گفت که از استفاده کاخ سفید از ترانه «فایروُرک» در ویدیویی از حملات نظامی آمریکا به ایران «مبهوت و منزجر» شده است.\u003cbr/\u003e\u003cbr/\u003eدر این ویدیو که در تیک‌تاک منتشر شده، تصاویر انفجار بمب‌ها با بخشی از ترانه هماهنگ شده که در آن کیتی پری عبارت «بوم، بوم، بوم» را می‌خواند.\u003cbr/\u003e\u003cbr/\u003eاو می‌گوید که این ترانه در اصل به‌عنوان سرودی درباره امید، التیام و قدرت درونی نوشته شده و استفاده کاخ سفید از آن، نقض معنایی است که این اثر نمایندگی می‌کند.\u003cbr/\u003e\u003cbr/\u003eپیش از این نیز شماری از خوانندگان، از جمله اولیویا رودریگو و آریانا گرانده، به استفاده دولت ترامپ از آثارشان اعتراض کرده‌اند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://bbc.in/4hxm5V1\" target=\"_blank\" rel=\"noopener\"\u003ehttps://bbc.in/4hxm5V1\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/BBCPersian\" target=\"_blank\"\u003e@BBCPersian\u003c/a\u003e",
      "date": "2026-07-26T01:21:44Z",
      "edited": false,
      "edit_date": "0001-01-01T00:00:00Z",
      "views": 24600,
      "forwards": 0,
      "replies": 0,
      "sender_id": 0,
      "sender_name": "BBCPersian"
    },
    {
      "id": 287708,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BB.png\u0026#39;)\"\u003e\u003cb\u003e🔻\u003c/b\u003e\u003c/i\u003eپلیس برلین یک اسلام‌گرا را مظنون حمله به مراسم دگرباشان جنسی معرفی کرد\u003cbr/\u003e\u003cbr/\u003eپلیس برلین می‌گوید که مظنون حمله با خودرو به جمعیت در مراسم دگرباشان جنسی این شهر، شناسایی شده اما هنوز بازداشت نشده است.\u003cbr/\u003e\u003cbr/\u003eسخنگوی پلیس گفت که این فرد برای نیروهای امنیتی شناخته‌شده و از اعضای «محافل اسلام‌گرا» در برلین است. به گفته او، عملیات برای بازداشت مظنون ادامه دارد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://bbc.in/4hxm5V1\" target=\"_blank\" rel=\"noopener\"\u003ehttps://bbc.in/4hxm5V1\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/BBCPersian\" target=\"_blank\"\u003e@BBCPersian\u003c/a\u003e",
      "date": "2026-07-26T01:46:43Z",
