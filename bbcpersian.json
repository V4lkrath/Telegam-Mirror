    {
      "id": 289579,
      "message": "\u003cb\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BB.png\u0026#39;)\"\u003e\u003cb\u003e🔻\u003c/b\u003e\u003c/i\u003eبازداشت ۹ فلسطینی که توسط شهرک‌نشینان اسرائیلی در خانه‌شان گرفتار شده بودند\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eخبرگزاری فلسطینی وفا گزارش کرده که نیروهای اسرائیلی ۹ عضو یک خانواده فلسطینی را که پس از حمله شهرک‌نشینان اسرائیلی در خانه خود گرفتار شده بودند، بازداشت کردند.\u003cbr/\u003e\u003cbr/\u003eاین خبرگزاری به نقل از منابع محلی نوشته که شهرک‌نشینان عصر یکشنبه به مدت بیش از سه ساعت خانه محمد ثابت ماجد حسون را در حومه روستای بیت ایمرین در شمال غربی نابلس محاصره کرده بودند.\u003cbr/\u003e\u003cbr/\u003eسربازان اسرائیلی سپس به این منطقه یورش برده و هر ۹ فلسطینیِ گرفتارشده را بازداشت کردند.\u003cbr/\u003e\u003cbr/\u003eاین خبر در حالی منتشر شد که سه خانواده فلسطینی دیگر نیز در پی محاصره توسط شهرک‌نشینان اسرائیلی، همچنان در خانه‌های خود در روستای قُصره در جنوب نابلس گرفتار هستند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://bbc.in/3SiQXOX\" target=\"_blank\" rel=\"noopener\" onclick=\"return confirm(\u0026#39;Open this link?\\n\\n\u0026#39;+this.href);\"\u003ehttps://bbc.in/3SiQXOX\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/BBCPersian\" target=\"_blank\"\u003e@BBCPersian\u003c/a\u003e",
      "date": "2026-08-17T06:58:06Z",
