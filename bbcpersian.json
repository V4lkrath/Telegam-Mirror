    {
      "id": 290485,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BB.png\u0026#39;)\"\u003e\u003cb\u003e🔻\u003c/b\u003e\u003c/i\u003eتیم ملی والیبال پسران زیر ۱۷ سال ایران با شکست سه بر یک فرانسه در مسابقه نهایی، قهرمان جهان شد.\u003cbr/\u003e\u003cbr/\u003eاین هفتمین برد متوالی پسران نوجوان ایران در دوحه بود.\u003cbr/\u003e\u003cbr/\u003eتیم نوجوانان پسر ایران در شش دیدار قبلی خود به ترتیب الجزایر، چین تایپه (دوبازی)، پاکستان (دوبازی) و آرژانتین را شکست داده بود تا با فرانسه در آخرین دیدار روبرو شد.\u003cbr/\u003e\u003cbr/\u003eشاگردان آرش صادقیانی عصر شنبه با نتیجه قاطع سه بر یک فرانسه را هم شکست دادند و قهرمان جهان شوند.\u003cbr/\u003e\u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93B8.png\u0026#39;)\"\u003e\u003cb\u003e📸\u003c/b\u003e\u003c/i\u003eirivf\u003cbr/\u003e\u003ca href=\"https://bbc.in/4cjxa8P\" target=\"_blank\" rel=\"noopener\"\u003ehttps://bbc.in/4cjxa8P\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/BBCPersian\" target=\"_blank\"\u003e@BBCPersian\u003c/a\u003e",
