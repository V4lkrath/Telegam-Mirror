    {
      "id": 285701,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BB.png\u0026#39;)\"\u003e\u003cb\u003e🔻\u003c/b\u003e\u003c/i\u003eدر ایران روز یکشنبه ۱۴ تیرماه به عنوان تعطیل رسمی اعلام شد\u003cbr/\u003e\u003cbr/\u003eهیئت دولت ایران یکشنبه ۱۴ تیر را در کل کشور تعطیل رسمی اعلام کرد.\u003cbr/\u003e\u003cbr/\u003eبه گفته هیئت دولت، این تصمیم پس از درخواست‌های متعدد از استان‌های مختلف برای امکان حضور مردم در مراسم تشییع علی خامنه‌ای و آیین‌های سوگواری، اتخاذ شده است.\u003cbr/\u003e\u003cbr/\u003eمراسم تشییع عمومی علی خامنه‌ای که تا ۱۸ تیر ادامه دارد، امروز در تهران آغاز شد.\u003cbr/\u003e\u003cbr/\u003eبه گزارش رسانه‌های ایران جعفر سبحانی تبریزی، نماز میت را فردا در مصلی تهران اقامه خواهد کرد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://bbc.in/4wre7B6\" target=\"_blank\" rel=\"noopener\"\u003ehttps://bbc.in/4wre7B6\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/BBCPersian\" target=\"_blank\"\u003e@BBCPersian\u003c/a\u003e",
