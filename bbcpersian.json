    {
      "id": 286143,
      "message": "\u003cb\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BB.png\u0026#39;)\"\u003e\u003cb\u003e🔻\u003c/b\u003e\u003c/i\u003eمراسم تشییع و خاکسپاری علی خامنه‌ای امروز در مشهد انجام می‌شود\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eستاد تشییع علی خامنه‌ای،‌ رهبر سابق ایران گفته است که هواپیمای حامل تابوت او و سایر اعضای خانواده‌اش که در حملات آمریکا کشته شدند، از عراق وارد فرودگاه هاشمی نژاد مشهد شده است.\u003cbr/\u003e\u003cbr/\u003eقرار است امروز در آخرین مرحله مراسم تشییع و خاکسپاری علی خامنه‌ای درزادگاهش مشهد برگزار شود.\u003cbr/\u003e\u003cbr/\u003eمراسم تشییع علی خامنه‌ای از جمعه قبل شروع شد.\u003cbr/\u003e\u003cbr/\u003eتابوت‌های رهبر سابق ایران و چهار نفر از اعضای خانواده‌اش صبح روز شنبه، ۱۳ تیر (چهارم ژوئیه ۲۰۲۶) در جایگاه مصلای تهران در معرض دید عموم مردم قرار گرفت.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://bbc.in/3SUw9x4\" target=\"_blank\" rel=\"noopener\"\u003ehttps://bbc.in/3SUw9x4\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/BBCPersian\" target=\"_blank\"\u003e@BBCPersian\u003c/a\u003e",
