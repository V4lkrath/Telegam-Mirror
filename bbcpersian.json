    {
      "id": 286742,
      "message": "\u003cb\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BB.png\u0026#39;)\"\u003e\u003cb\u003e🔻\u003c/b\u003e\u003c/i\u003eوقوع انفجار در جزیره قشم\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eخبرگزاری دولتی ایرنا از شنیده شدن صدای انفجار در جزیره قشم خبر داده است.\u003cbr/\u003e\u003cbr/\u003eایرنا جزییات بیشتری در خصوص این انفجارها اعلام نکرده است.\u003cbr/\u003e\u003cbr/\u003eدر روزهای گذشته نیز صدای انفجار در جزیره قشم شنیده شده بود.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://bbc.in/4wLqFDE\" target=\"_blank\" rel=\"noopener\"\u003ehttps://bbc.in/4wLqFDE\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/BBCPersian\" target=\"_blank\"\u003e@BBCPersian\u003c/a\u003e",
