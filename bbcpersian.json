    {
      "id": 281436,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BB.png\u0026#39;)\"\u003e\u003cb\u003e🔻\u003c/b\u003e\u003c/i\u003eپادکست برنامه شصت دقیقه \u003cbr/\u003eدوشنبه ۲۸ اردیبهشت ۱۴۰۵ \u003cbr/\u003e\u003cbr/\u003eاین نسخه رادیویی برنامه شصت دقیقه تلویزیون فارسی بی‌بی‌سی است که هرشب بعد از پخش، با حجم کم از اپلیکیشن‌های پادگیر و صفحه تلگرام بی‌بی‌سی فارسی در دسترس است. \u003cbr/\u003e\u003cbr/\u003eبا هشتگ BBCPersianRadio# با ما در ارتباط باشید.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/BBCPersian\" target=\"_blank\"\u003e@BBCPersian\u003c/a\u003e",
      "date": "2026-05-19T04:54:09Z",
