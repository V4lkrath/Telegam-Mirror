    {
      "id": 283133,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BB.png\u0026#39;)\"\u003e\u003cb\u003e🔻\u003c/b\u003e\u003c/i\u003eارتش اسرائیل: شلیک موشک از یمن را رصد کردیم و مشغول رهگیری هستیم\u003cbr/\u003e\u003cbr/\u003eارتش اسرائیل با بیانیه‌ای اعلام کرده شلیک یک موشک از سمت یمن را رصد کرده و مشغول رهگیری آن است.\u003cbr/\u003e\u003cbr/\u003eهمزمان آژيرهای خطر در مناطقی از اسرائیل از جمله تل آویو و شهرهای جنوبی این کشور به صدا در آمده و از شهروندان خواسته شده پناه بگیرند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://bbc.in/4fwDUTo\" target=\"_blank\" rel=\"noopener\"\u003ehttps://bbc.in/4fwDUTo\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/BBCPersian\" target=\"_blank\"\u003e@BBCPersian\u003c/a\u003e",
