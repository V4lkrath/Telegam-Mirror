    {
      "id": 282623,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BB.png\u0026#39;)\"\u003e\u003cb\u003e🔻\u003c/b\u003e\u003c/i\u003e نگرانی از پیش‌روی ارتش اسرائیل در خاک لبنان در جلسه اضطراری شورای امنیت\u003cbr/\u003e\u003cbr/\u003eشورای امنیت سازمان ملل متحد عصر دوشنبه به درخواست فرانسه جلسه اضطراری درباره تشدید حملات اسرائیل به لبنان و برافراشتن پرچم این کشور بر فراز قلعه تاریخی بوفور لبنان، برگزار کرد.\u003cbr/\u003e\u003cbr/\u003eنمایندگان اعضای این شورا به همراه لبنان و اسرائیل در این جلسه نظرات خود درباره این تحولات را ایراد کردند که خلاصه برخی از آنها را در لینک زیر می‌توانید بخوانید.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://bbc.in/4dUSRvR\" target=\"_blank\" rel=\"noopener\"\u003ehttps://bbc.in/4dUSRvR\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/BBCPersian\" target=\"_blank\"\u003e@BBCPersian\u003c/a\u003e",
      "date": "2026-06-02T03:16:01Z",
