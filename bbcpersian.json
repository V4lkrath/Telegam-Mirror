    {
      "id": 284348,
      "message": "\u003cb\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BB.png\u0026#39;)\"\u003e\u003cb\u003e🔻\u003c/b\u003e\u003c/i\u003eیک مامور نیروی انتظامی در تیراندازی افراد مسلح در خاش کشته شد\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eمرکز اطلاع‌رسانی پلیس سیستان و بلوچستان اعلام کرد یک مامور فرماندهی نیروی انتظامی شهرستان خاش، در پی تیراندازی افراد مسلح ناشناس کشته شده است.\u003cbr/\u003e\u003cbr/\u003eاین مرکز نام این فرد را ستوان سوم عبدالسلام کُرد اعلام کرده است.\u003cbr/\u003e\u003cbr/\u003eبه گفته پلیس فراجا، عملیات شناسایی و دستگیری این افراد آغاز شده است.\u003cbr/\u003e\u003cbr/\u003eدر ماه‌های اخیر حمله افراد مسلح به نیروهای امنیتی در شهرهای مختلف استان سیستان و بلوچستان، بارها خبرساز شده است.\u003cbr/\u003e\u003cbr/\u003eگروه جیش‌العدل در این منطقه فعالیت می‌کند. پاییز سال گذشته این گروه در «جبهه مبارزین بلوچ» ادغام شد.\u003cbr/\u003e\u003cbr/\u003eعلاوه بر جیش‌العدل نام چند گروه دیگر نیز به عنوان اعضای این ائتلاف ذکر شده است از جمله «جنبش پادا بلوچ»، «حرکت نصر بلوچ»، «گروه محمد رسول‌الله» و «جنگجویان خودجوش بلوچ».\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://bbc.in/4vgfIJP\" target=\"_blank\" rel=\"noopener\"\u003ehttps://bbc.in/4vgfIJP\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/BBCPersian\" target=\"_blank\"\u003e@BBCPersian\u003c/a\u003e",
