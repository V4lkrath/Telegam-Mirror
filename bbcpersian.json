    },
    {
      "id": 282975,
      "message": "\u003cb\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BB.png\u0026#39;)\"\u003e\u003cb\u003e🔻\u003c/b\u003e\u003c/i\u003eباز شدن حریم هوایی کویت پس از حملات شب گذشته\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BB.png\u0026#39;)\"\u003e\u003cb\u003e🔻\u003c/b\u003e\u003c/i\u003eاداره هوانوردی غیرنظامی کویت می‌گوید فضای هوایی‌اش را باز کرده است. ترافیک هوایی در اثر حملات ایران ساعاتی بسته بود.\u003cbr/\u003e\u003cbr/\u003eکویت گفت حریم هوایی‌اش را به عنوان یک اقدام احتیاطی بست و ۱۱ پرواز خطوط هوایی کویت و جزیره به فرودگاه‌های نزدیک هدایت شدند.\u003cbr/\u003e\u003cbr/\u003eمقامات کویتی پیشتر گفته بودند که پدافند با «تهدیدات موشکی و پهپادی خصمانه» مقابله کرده است.\u003cbr/\u003e\u003cbr/\u003eسپاه پاسداران گفته «در پاسخ» به حمله پهپادهای آمریکایی به قشم و سیریک، پایگاه هوایی آمریکا در کویت و ناوگان پنجم نیروی دریایی آمریکا در بحرین را هدف قرار داده است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://bbc.in/4a3p3fF\" target=\"_blank\" rel=\"noopener\"\u003ehttps://bbc.in/4a3p3fF\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/BBCPersian\" target=\"_blank\"\u003e@BBCPersian\u003c/a\u003e",
      "date": "2026-06-06T09:29:44Z",
      "edited": false,
      "edit_date": "0001-01-01T00:00:00Z",
      "views": 32600,
      "forwards": 0,
