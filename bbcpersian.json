    },
    {
      "id": 289649,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BB.png\u0026#39;)\"\u003e\u003cb\u003e🔻\u003c/b\u003e\u003c/i\u003e خطر افزایش دما بر اثر تغییرات اقلیمی برای سلامت سالمندان بسیار دست‌کم گرفته شده است. این نتیجه یک پژوهش بر اساس مدل‌سازی است که امروز در نشریه لنست منتشر شد.\u003cbr/\u003e\u003cbr/\u003eاین پژوهش در تابستانی سوزان در نیمکره شمالی منتشر شده است که گرمای شدید رکوردهای متعددی را شکست و در مرگ ده‌ها هزار نفر نقش داشت.\u003cbr/\u003e\u003cbr/\u003eبرای انجام این پژوهش، پژوهشگران آمریکایی به سرپرستی محققان دانشگاه استنفورد تلاش کردند برآورد کنند که گرمایش جهانی ناشی از فعالیت‌های انسان با چه میزان و دفعاتی دما را به سطوحی می‌رساند که سالمندان قادر به تحمل آن نیستند.\u003cbr/\u003eمتن کامل را اینجا بخوانید: \u003ca href=\"https://bbc.in/4bTGKix\" target=\"_blank\" rel=\"noopener\"\u003ehttps://bbc.in/4bTGKix\u003c/a\u003e \u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93B8.png\u0026#39;)\"\u003e\u003cb\u003e📸\u003c/b\u003e\u003c/i\u003e GettyImages\u003cbr/\u003e \u003ca href=\"https://t.me/BBCPersian\" target=\"_blank\"\u003e@BBCPersian\u003c/a\u003e",
