    {
      "id": 287472,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BB.png\u0026#39;)\"\u003e\u003cb\u003e🔻\u003c/b\u003e\u003c/i\u003e\u003cb\u003eنخست وزیر عراق برای دیداری رسمی وارد تهران شد\u003cbr/\u003e\u003c/b\u003e\u003cbr/\u003eعلی زیدی، نخست وزیر عراق در سفری رسمی وارد تهران شد.\u003cbr/\u003e\u003cbr/\u003eحیدر عبود، ‌سخنگوی عراق پیش‌تر اعلام کرد که آقای زیدی به دعوت مسعود پزشکیان،‌ رئيس جمهور ایران به همراه هیئتی به ایران می‌رود.\u003cbr/\u003e\u003cbr/\u003eبه گفته سخنگوی عراق،‌ آقای زیدی در این سفر در مورد تلاش‌ها برای «توقف تنش در منطقه و پرونده های تجاری، حمل و نقل و گاز وارداتی» رایزنی خواهد کرد.\u003cbr/\u003e\u003cbr/\u003eاو همچنین گفت که رویکرد عراق دخالت نکردن در امور دیگر کشورها و احترام به معاهدات بین المللی است و با توجه به منافع اقتصادی کشور، به دنبال گشایش در روابط خارجی است.\u003cbr/\u003e\u003ca href=\"https://t.me/BBCPersian\" target=\"_blank\"\u003e@BBCPersian\u003c/a\u003e",
      "date": "2026-07-23T10:02:09Z",
      "edited": false,
      "edit_date": "0001-01-01T00:00:00Z",
      "views": 39700,
      "forwards": 0,
      "replies": 0,
      "sender_id": 0,
      "sender_name": "BBCPersian"
    },
    {
      "id": 287473,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BB.png\u0026#39;)\"\u003e\u003cb\u003e🔻\u003c/b\u003e\u003c/i\u003e\u003cb\u003eعمان از تلاش‌های دیپلماتیک با هدف دستیابی به ثبات در منطقه خبر داد\u003cbr/\u003e\u003c/b\u003e\u003cbr/\u003eعمان اعلام کرد که برای ازسرگیری روند سیاسی با هدف دستیابی به امنیت و ثبات در منطقه، در حال هماهنگی با عربستان سعودی، طرف‌های یمنی و فرستاده ویژه سازمان ملل در امور یمن است.\u003cbr/\u003e\u003cbr/\u003eوزارت امور خارجه عمان در بیانیه‌ای همچنین بر لزوم جلوگیری از تشدید تنش‌ها و پرهیز از هرگونه اقدامی که بتواند اوضاع در دریای سرخ را وخیم‌تر کند و آزادی کشتیرانی را به خطر بیندازد، تأکید کرد.\u003cbr/\u003e\u003ca href=\"https://t.me/BBCPersian\" target=\"_blank\"\u003e@BBCPersian\u003c/a\u003e",
      "date": "2026-07-23T10:05:34Z",
