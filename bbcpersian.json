    {
      "id": 289564,
      "message": "\u003cb\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BB.png\u0026#39;)\"\u003e\u003cb\u003e🔻\u003c/b\u003e\u003c/i\u003eثابت ماندن قیمت نفت در معاملات ابتدایی آغاز هفته\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eقیمت نفت در آغاز معاملات امروز ثابت ماند و رشد هفته گذشته خود را حفظ کرد.\u003cbr/\u003eبه گزارش خبرگزاری رویترز در ساعات ابتدایی باز شدن بازارها در شرق آسیا، قیمت معاملات آتی نفت خام برنت بدون تغییر در سطح ۸۸/۵۵ دلار در هر بشکه باقی ماند، در حالی که قیمت معاملات آتی نفت خام وست تگزاس اینترمدیت در همین بازه زمانی با ۱۴ سنت کاهش به ۸۲/۲۶ دلار در هر بشکه رسید.\u003cbr/\u003eقیمت نفت برنت و وست تگزاس اینترمدیت هفته گذشته و در پی حملات به نفتکش‌های امارات در تنگه هرمز و تأسیسات پالایشگاهی شرکت آرامکوی سعودی در دریای سرخ، بیش از ۵ درصد افزایش یافته بود.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://bbc.in/4zkP4BV\" target=\"_blank\" rel=\"noopener\" onclick=\"return confirm(\u0026#39;Open this link?\\n\\n\u0026#39;+this.href);\"\u003ehttps://bbc.in/4zkP4BV\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/BBCPersian\" target=\"_blank\"\u003e@BBCPersian\u003c/a\u003e",
