    {
      "id": 286315,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BB.png\u0026#39;)\"\u003e\u003cb\u003e🔻\u003c/b\u003e\u003c/i\u003eعراقچی وارد عمان شد\u003cbr/\u003e\u003cbr/\u003eعباس عراقچی، وزیر خارجه ایران برای گفت‌و‌گو با مقامات عمان وارد مسقط شد.\u003cbr/\u003e\u003cbr/\u003eبه گزارش منابع خبری این سفر در ادامه رایزنی های دو جانبه ایران و عمان درباره تحولات منطقه به خصوص تنگه هرمز انجام شده است.\u003cbr/\u003e\u003cbr/\u003eقرار است وزیران امور خارجه ایران و عمان درباره «تنظیم سازوکارهای مقتضی برای تردد ایمن کشتی‌ها از تنگه هرمز، براساس ماده ۵ یادداشت تفاهم اسلام‌آباد» گفتگو و تبادل نظر کنند.\u003cbr/\u003e\u003cbr/\u003eاین سفر در حالی صورت می‌گیرد که در روزهای اخیر تنش بر سر تنگه هرمز با حملات متقابل آمریکا و ایران افزایش یافته است.\u003cbr/\u003e\u003cbr/\u003eدر همین حال هیئتی از مذاکره‌کنندگان قطری با هدف فراهم کردن زمینه ازسرگیری مذاکرات ایران و آمریکا و کاهش تنش‌ها بین دو طرف به ایران سفر کرده‌اند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://bbc.in/44UCJq3\" target=\"_blank\" rel=\"noopener\"\u003ehttps://bbc.in/44UCJq3\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/BBCPersian\" target=\"_blank\"\u003e@BBCPersian\u003c/a\u003e",
