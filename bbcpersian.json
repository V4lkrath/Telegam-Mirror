    {
      "id": 284131,
      "message": "تازه‌ترین خبرهای جهان چهارشنبه ۲۷ خرداد ۱۴۰۵ از رادیو بی‌بی‌سی در لندن",
      "date": "2026-06-17T12:58:45Z",
      "edited": false,
      "edit_date": "0001-01-01T00:00:00Z",
