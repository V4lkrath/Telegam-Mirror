    {
      "id": 285747,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BB.png\u0026#39;)\"\u003e\u003cb\u003e🔻\u003c/b\u003e\u003c/i\u003eگزارش خبرگزاری فرانسه از تدابیر امنیتی شدید در مصلای تهران\u003cbr/\u003e\u003cbr/\u003eخبرگزاری فرانسه می‌گوید که از شامگاه جمعه، مصلای تهران با موانع امنیتی و استقرار نیروهای انتظامی در اطراف آن، به محلی با تدابیر شدید امنیتی تبدیل شده بود.\u003cbr/\u003e\u003cbr/\u003eبر اساس این گزارش، صدها نفر بیش از ده ساعت پیش از باز شدن درهای مصلا در محل تجمع کرده بودند.\u003cbr/\u003e\u003cbr/\u003eخبرنگار خبرگزاری فرانسه همچنین گزارش داده است که شرکت‌کنندگان در مراسم، با لباس‌های سیاه و پرچم‌های سرخ در محوطه مصلا حضور داشتند و شعارهای «مرگ بر آمریکا» و «انتقام، انتقام» سر می‌دادند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://bbc.in/4vNBXao\" target=\"_blank\" rel=\"noopener\"\u003ehttps://bbc.in/4vNBXao\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/BBCPersian\" target=\"_blank\"\u003e@BBCPersian\u003c/a\u003e",
      "date": "2026-07-05T03:00:45Z",
      "edited": false,
      "edit_date": "0001-01-01T00:00:00Z",
