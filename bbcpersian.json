    {
      "id": 288113,
      "message": "\u003cb\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BB.png\u0026#39;)\"\u003e\u003cb\u003e🔻\u003c/b\u003e\u003c/i\u003eاسرائیل تونل‌های نزدیک به قلعه تاریخی بوفورت در جنوب لبنان را منفجر کرد\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eاسرائیل در نزدیکی قلعه تاریخی بوفورت در جنوب لبنان، انفجارهای شدیدی انجام داده است.\u003cbr/\u003e\u003cbr/\u003eبنیامین نتانیاهو، نخست‌وزیر اسرائیل، گفت که ارتش این کشور تونل‌هایی را که حزب‌الله از آن‌ها استفاده می‌کرد، با استفاده از حدود ۷۰۰ تن مواد منفجره منهدم کرده است.\u003cbr/\u003e\u003cbr/\u003eوزارت فرهنگ لبنان اعلام کرد که انفجارها در منطقه‌ای روبه‌روی قلعه رخ داده‌اند و هشدار داد که لرزش‌های ناشی از این انفجارها ممکن است به مناطق اطراف قلعه آسیب رسانده باشد.\u003cbr/\u003e\u003cbr/\u003eارتش اسرائیل دو ماه پیش کنترل قلعه بوفورت را به دست گرفت؛ قلعه‌ای که به دلیل قرار گرفتن در یک موقعیت راهبردی مهم، از اهمیت زیادی برخوردار است.\u003cbr/\u003e\u003cbr/\u003eقدمت این قلعه به دوران جنگ‌های صلیبی بازمی‌گردد و یونسکو هفته گذشته آن را در فهرست میراث جهانی در معرض خطر قرار داد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://bbc.in/4wzWlw0\" target=\"_blank\" rel=\"noopener\"\u003ehttps://bbc.in/4wzWlw0\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/BBCPersian\" target=\"_blank\"\u003e@BBCPersian\u003c/a\u003e",
