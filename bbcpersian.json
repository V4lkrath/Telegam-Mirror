    {
      "id": 286149,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BB.png\u0026#39;)\"\u003e\u003cb\u003e🔻\u003c/b\u003e\u003c/i\u003eمنابع خبری در ایران به نقل از مردم محلی از شنیده شده صدای دو انفجار در بوشهر خبر داده اند. هنوز گزارش رسمی در مورد محل این انفجارها منتشر نشده است.\u003cbr/\u003e\u003cbr/\u003eصبح امروز آمریکا نقاطی را در این استان هدف قرار داد.\u003cbr/\u003e\u003cbr/\u003eپیش‌تر اخباری در مورد اصابت پرتابه به نیروگاه بوشهر منتشر شد، اما فرماندار بوشهر این خبر را تکذیب کرد.\u003cbr/\u003e\u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93B8.png\u0026#39;)\"\u003e\u003cb\u003e📸\u003c/b\u003e\u003c/i\u003eUGC\u003cbr/\u003e\u003ca href=\"https://t.me/BBCPersian\" target=\"_blank\"\u003e@BBCPersian\u003c/a\u003e",
