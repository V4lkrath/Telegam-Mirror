    {
      "id": 285304,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BB.png\u0026#39;)\"\u003e\u003cb\u003e🔻\u003c/b\u003e\u003c/i\u003eایران می‌گوید که پروازهای مسیر تهران–دوبی از فردا (دوشنبه)  از‌ سر گرفته می‌شود\u003cbr/\u003e\u003cbr/\u003eمدیرعامل شرکت شهر فرودگاهی امام خمینی از فعال شدن مجدد مسیر هوایی تهران-دوبی خبر داده و گفته است پروازها در این مسیر از فردا (دوشنبه ۸ تیرماه) از سرگرفته می‌شود.\u003cbr/\u003e\u003cbr/\u003eبه گفته رامین کاشف‌آذر در حال حاضر شرکت‌های هواپیمایی ایرانی در این مسیر فعالیت خواهند داشت.\u003cbr/\u003e\u003cbr/\u003eاز زمان شروع جنگ در اسفند ماه ۱۴۰۴ پروازها در مسیر تهران دوبی به حال تعلیق درآمد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://bbc.in/4g5oZzI\" target=\"_blank\" rel=\"noopener\"\u003ehttps://bbc.in/4g5oZzI\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/BBCPersian\" target=\"_blank\"\u003e@BBCPersian\u003c/a\u003e",
