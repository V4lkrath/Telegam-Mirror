    },
    {
      "id": 290478,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BB.png\u0026#39;)\"\u003e\u003cb\u003e🔻\u003c/b\u003e\u003c/i\u003eکتائب حزب‌الله می‌گوید پیش از حملات آمریکا و عربستان «هشدار» دریافت کرده بود\u003cbr/\u003e\u003cbr/\u003eکتائب حزب‌الله، نیروی شبه‌نظامی مورد حمایت ایران در عراق، می گوید که پیش از حملات آمریکا و عربستان «هشدار» دریافت کرده بود.\u003cbr/\u003e\u003cbr/\u003eبه گزارش الجزیره، کتائب حزب‌الله عراق می‌گوید فالح الفیاض، فرمانده نیروهای حشد الشعبی، پیش از حمله مشترک آمریکا و عربستان به مواضع این گروه در ماه گذشته، هشدار داده بود.\u003cbr/\u003e\u003cbr/\u003eیک مقام امنیتی این گروه گفت که کتائب حزب‌الله پس از دریافت این هشدار اقدامات پیشگیرانه انجام داد، اما گفت که اطلاعات کامل نبود و فقط خبر حمله به این گروه یا سایر جناح‌های همسو با ایران را شامل می‌شد.\u003cbr/\u003e\u003cbr/\u003eایالات متحده و عربستان سعودی در ماه ژوئیه حملاتی را علیه شبه‌ نظامیان تحت حمایت ایران در عراق انجام دادند که منجر به کشته‌شدن دست‌کم ۲۰ نیروی کتائب حزب‌الله شد و پنج عضو سپاه ایران نیز در این حملات جان باختند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://bbc.in/4gzTc8x\" target=\"_blank\" rel=\"noopener\"\u003ehttps://bbc.in/4gzTc8x\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/BBCPersian\" target=\"_blank\"\u003e@BBCPersian\u003c/a\u003e",
      "date": "2026-08-29T19:08:25Z",
      "edited": false,
      "edit_date": "0001-01-01T00:00:00Z",
      "views": 33800,
