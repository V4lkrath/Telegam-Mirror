    {
      "id": 284114,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BB.png\u0026#39;)\"\u003e\u003cb\u003e🔻\u003c/b\u003e\u003c/i\u003eآژانس بین‌المللی انرژی: ذخایر نفتی کشورهای سازمان همکاری اقتصادی به کمترین سطح از سال ۱۹۹۰ رسید\u003cbr/\u003e\u003cbr/\u003eآژانس بین‌المللی انرژی اعلام کرده است که ذخایر نفتی کشورهای عضو سازمان همکاری و توسعه اقتصادی به پایین‌ترین سطح از سال ۱۹۹۰ تاکنون رسیده است.\u003cbr/\u003e\u003cbr/\u003eاین آژانس می‌گوید به دلیل جنگ، برداشت از ذخایر اضطراری نفت در ماه گذشته میلادی (مه) با سرعت بیشتری انجام شده است.\u003cbr/\u003e\u003cbr/\u003eاین نهاد در تازه‌ترین گزارش ماهانه‌اش نوشت که اگر تفاهم آمریکا و ایران حفظ شود، بازار جهانی نفت به‌تدریج پیامدهای بسته شدن تنگه هرمز را پشت سرخواهد گذاشت.\u003cbr/\u003e\u003cbr/\u003eآژانس بین‌المللی انرژی همچنین افزود جنگ در خاورمیانه بزرگ‌ترین اختلال در تاریخ بازار جهانی نفت را به وجود آورده است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://bbc.in/4eh9GCQ\" target=\"_blank\" rel=\"noopener\"\u003ehttps://bbc.in/4eh9GCQ\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/BBBCPersian\" target=\"_blank\"\u003e@BBBCPersian\u003c/a\u003e",
      "date": "2026-06-17T10:16:44Z",
