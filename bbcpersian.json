    {
      "id": 284251,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BB.png\u0026#39;)\"\u003e\u003cb\u003e🔻\u003c/b\u003e\u003c/i\u003eترامپ و پزشکیان توافق پایان دادن به جنگ را امضا کردند\u003cbr/\u003e\u003cbr/\u003eروسای جمهور آمریکا و ایران یک توافق اولیه صلح را با هدف پایان دادن به جنگ، امضا کرده‌اند؛ توافقی که بلافاصله اجرایی می‌شود.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://bbc.in/44iErBe\" target=\"_blank\" rel=\"noopener\"\u003ehttps://bbc.in/44iErBe\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/BBCPersian\" target=\"_blank\"\u003e@BBCPersian\u003c/a\u003e",
