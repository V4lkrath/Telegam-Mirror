    {
      "id": 285667,
      "message": "\u003cb\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BB.png\u0026#39;)\"\u003e\u003cb\u003e🔻\u003c/b\u003e\u003c/i\u003eتشییع خامنه‌ای؛ اقامه نماز یکشنبه صبح\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eبنابر اطلاعیه‌ای که رسانه‌های ایران منتشر کرده‌اند، مراسم اقامه نماز برای علی خامنه‌ای و اعضای خانواده‌اش فردا ساعت شش صبح در مصلای تهران برگزار می‌شود.\u003cbr/\u003e\u003cbr/\u003eدر این بیانیه‌ ذکر نشده که نماز را چه کسی اقامه خواهد کرد.\u003cbr/\u003e\u003cbr/\u003eمجتبی خامنه‌ای از زمان شروع جنگ که پدر و چند عضو خانواده‌اش در اولین لحظات جنگ ۴۰ روزه کشته شدند در انظار دیده نشده و صوت و تصویری از او منتشر نشده است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://bbc.in/3Rkt2xY\" target=\"_blank\" rel=\"noopener\"\u003ehttps://bbc.in/3Rkt2xY\u003c/a\u003e\u003cbr/\u003e \u003ca href=\"https://t.me/BBCPersian\" target=\"_blank\"\u003e@BBCPersian\u003c/a\u003e",
