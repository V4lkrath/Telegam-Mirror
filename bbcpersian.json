    {
      "id": 285486,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BB.png\u0026#39;)\"\u003e\u003cb\u003e🔻\u003c/b\u003e\u003c/i\u003eیک مامور نیروی انتظامی در تیراندازی افراد ناشناس در سیستان و بلوچستان کشته شد\u003cbr/\u003e\u003cbr/\u003eخبرگزاری‌های ایران از کشته شدن یک مامور نیروی انتظامی در شهرستان سیب سوران در استان سیستان و بلوچستان خبر داده‌اند.\u003cbr/\u003e\u003cbr/\u003eنام این فرد «محمد پلنگی» اعلام شده که به گزارش رسانه‌های ایران «توسط افراد مسلح ناشناس» هدف تیراندازی با سلاح گرم قرار گرفته وکشته شده است.\u003cbr/\u003e\u003cbr/\u003eخبرگزاری فارس دیروز در گزارشی به افزایش درگیری‌ها در این استان اشاره کرده بود؛ از جمله کشته شدن یک مامور انتظامی در ۱۷ و ۱۸ خرداد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://bbc.in/442nc7p\" target=\"_blank\" rel=\"noopener\"\u003ehttps://bbc.in/442nc7p\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/BBCPersian\" target=\"_blank\"\u003e@BBCPersian\u003c/a\u003e",
      "date": "2026-07-01T08:02:05Z",
      "edited": false,
      "edit_date": "0001-01-01T00:00:00Z",
      "views": 26900,
      "forwards": 0,
