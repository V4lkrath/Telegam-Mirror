    {
      "id": 286632,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29AA1.png\u0026#39;)\"\u003e\u003cb\u003e⚡️\u003c/b\u003e\u003c/i\u003eاسپانیا با دو گل و خلاف بیشتر پیشبینی‌ها فرانسه را شکست داد و به فینال رسید.\u003cbr/\u003e\u003cbr/\u003eپای دیگر فینال در بازی فردا شب میان انگلیس و آرژانتین مشخص می‌شود.\u003cbr/\u003e\u003cbr/\u003eاینجا ببینید:\u003cbr/\u003e\u003ca href=\"https://bbc.in/4wea1MX\" target=\"_blank\" rel=\"noopener\"\u003ehttps://bbc.in/4wea1MX\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/bbcpersian\" target=\"_blank\"\u003e@bbcpersian\u003c/a\u003e",
