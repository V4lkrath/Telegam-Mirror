    {
      "id": 288161,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BB.png\u0026#39;)\"\u003e\u003cb\u003e🔻\u003c/b\u003e\u003c/i\u003e\u003cb\u003eشمار ماموران کشته‌شده در درگیری مسلحانه شادگان به سه نفر رسید\u003cbr/\u003e\u003c/b\u003e\u003cbr/\u003eفرمانده انتظامی خوزستان می‌گوید که علیرضا فتحی، ماموری که روز پنجشنبه در عملیات دستگیری دو متهم به قاچاق سلاح و مهمات در شادگان زخمی شده بود، بر اثر شدت جراحات جان باخته است.\u003cbr/\u003e\u003cbr/\u003eبه گفته پلیس، افراد تحت تعقیب با مشاهده ماموران به سوی آنها تیراندازی کردند و در تبادل آتش، مهدی مهدوی‌کیا و سینا سیاه‌نژاد نیز کشته شدند.\u003cbr/\u003e\u003cbr/\u003eپلیس می‌گوید که پس از این درگیری، محل اختفای دو متهم شناسایی شد؛ یک نفر در تبادل آتش کشته و نفر دوم پس از زخمی شدن بازداشت شد.\u003cbr/\u003e\u003ca href=\"https://bbc.in/4fzwwpW\" target=\"_blank\" rel=\"noopener\"\u003ehttps://bbc.in/4fzwwpW\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/BBCPersian\" target=\"_blank\"\u003e@BBCPersian\u003c/a\u003e",
      "date": "2026-07-31T23:23:43Z",
