    {
      "id": 223316,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29AA1.png\u0026#39;)\"\u003e\u003cb\u003e⚡️\u003c/b\u003e\u003c/i\u003eسالگرد واقعه کوی دانشگاه تهران؛ ۱۸ تیر سال ۷۸ چه‌ تاثیری بر مسیر جنبش دانشجویی ایران داشت؟ گفت‌وگو با منوچهر محمدی\u003cbr/\u003e\u003ca href=\"https://t.me/FarsiVOA\" target=\"_blank\"\u003e@FarsiVOA\u003c/a\u003e",
