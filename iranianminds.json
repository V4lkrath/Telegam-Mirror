      "id": 26939,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B4.png\u0026#39;)\"\u003e\u003cb\u003e🔴\u003c/b\u003e\u003c/i\u003e لیست فرماندهان جدیدی که موشتبا انتخاب کرد: \u003cbr/\u003e\u003cbr/\u003e\u003cblockquote\u003eتروریست سرلشکر علی عبداللهی به عنوان رئیس ستاد کل نیروهای مسلح.\u003c/blockquote\u003e\u003cbr/\u003e\u003cblockquote\u003eتروریست امیر کیومرث حیدری به عنوان جانشین رئیس ستاد کل نیروهای مسلح.\u003c/blockquote\u003e\u003cbr/\u003e\u003cblockquote\u003eتروریست سرلشکر احمد وحیدی به عنوان فرمانده سپاه.\u003c/blockquote\u003e\u003cbr/\u003e\u003cblockquote\u003eتروریست سرلشکر مصطفی ایزدی به عنوان جانشین فرمانده کل سپاه.\u003c/blockquote\u003e\u003cbr/\u003e\u003cblockquote\u003eتروریست حجت الاسلام طائب به عنوان رئیس سازمان بسیج مستضعفین.\u003c/blockquote\u003e\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/IranianMinds\" target=\"_blank\"\u003e@IranianMinds\u003c/a\u003e",
