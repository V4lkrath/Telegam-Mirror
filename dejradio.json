    {
      "id": 6848,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F8EA4.png\u0026#39;)\"\u003e\u003cb\u003e🎤\u003c/b\u003e\u003c/i\u003e قاهره؛ ۴۵ سال میعادگاه ایرانیان وفادار به شاهنشاه فقید ایران زمین\u003cbr/\u003e\u003cbr/\u003eدر آستانه مراسم سالگرد درگذشت شاهنشاه فقید ایران، محمدرضا شاه پهلوی، با داریوش شفا، رئیس دفتر شهبانو فرح پهلوی، درباره تصمیم دولت مصر برای محدود کردن مراسم امسال به اعضای خاندان پهلوی به دلایل امنیتی و نیز اهمیت حفظ میراث دوستی ایران و مصر گفت‌وگو کردیم. \u003cbr/\u003e\u003cbr/\u003eدر این گفت‌وگو، نقش تاریخی رئیس‌جمهور انور سادات، پیام شهبانو فرح پهلوی درباره قدردانی از ملت و دولت مصر، و مسئولیت ایرانیان در پاسداری از این سرمایه ارزشمند برای آینده روابط دو کشور بررسی شد؛ میراثی که فراتر از سیاست، بر پایه وفاداری، احترام و حافظه تاریخی دو ملت است.\u003cbr/\u003e\u003cbr/\u003e  \u003ca href=\"?q=%23%D8%B4%D8%A7%D9%87%D9%86%D8%B4%D8%A7%D9%87_%D8%A2%D8%B1%DB%8C%D8%A7%D9%85%D9%87%D8%B1\"\u003e#شاهنشاه_آریامهر\u003c/a\u003e \u003ca href=\"?q=%23%D8%B4%D9%87%D8%A8%D8%A7%D9%86%D9%88_%D9%81%D8%B1%D8%AD_%D9%BE%D9%87%D9%84%D9%88%DB%8C\"\u003e#شهبانو_فرح_پهلوی\u003c/a\u003e \u003ca href=\"?q=%23%D9%82%D8%A7%D9%87%D8%B1%D9%87\"\u003e#قاهره\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
