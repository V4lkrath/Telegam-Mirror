      "message": "\u003ca href=\"https://x.com/PahlaviComms/status/2076721276110921961?s=20\" target=\"_blank\" rel=\"noopener\" onclick=\"return confirm(\u0026#39;Open this link?\\n\\n\u0026#39;+this.href);\"\u003e\u003cb\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9191.png\u0026#39;)\"\u003e\u003cb\u003e👑\u003c/b\u003e\u003c/i\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e  فرزند بیژن جزنی، نظریه‌پرداز و عضو بنیان‌گذار سازمان چریک‌های فدایی خلق ایران از مسیری سخن می‌گوید که او را به انقلاب ملی شیر و خورشید به رهبری شاهزاده رضا پهلوی رسانده است.\u003c/b\u003e\u003c/a\u003e\u003cbr/\u003e\u003cbr/\u003eروایت مازیار (ماکسیمیلیان) جزنی یادآور این حقیقت است که آنچه آینده ایران را رقم می‌زند، نه گذشته‌های متفاوت، بلکه همگرایی بر سر مقصدی مشترک است. انقلاب ملی ایران به رهبری شاهزاده رضا پهلوی، متعلق به همه ایرانیانی است که آزادی، آبادانی و استقرار یک حکومت ملی را بر هرگونه اختلاف، پیشینه یا گرایش سیاسی مقدم می‌دانند.\u003cbr/\u003eدر این دیدار، همچنین درباره همکاری‌های حقوقی آقای جزنی با پروژه شکوفایی ایران گفت‌وگو و تبادل نظر شد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%B4%D8%A7%D9%87%D8%B2%D8%A7%D8%AF%D9%87_%D8%B1%D8%B6%D8%A7_%D9%BE%D9%87%D9%84%D9%88%DB%8C\"\u003e#شاهزاده_رضا_پهلوی\u003c/a\u003e \u003ca href=\"?q=%23%D8%A7%D9%86%D9%82%D9%84%D8%A7%D8%A8_%D9%85%D9%84%DB%8C_%D8%A7%DB%8C%D8%B1%D8%A7%D9%86\"\u003e#انقلاب_ملی_ایران\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
