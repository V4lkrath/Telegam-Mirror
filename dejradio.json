      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93B7.png\u0026#39;)\"\u003e\u003cb\u003e📷\u003c/b\u003e\u003c/i\u003e تصاویر جدید از اصابت بمب به سقف خانه فریدون عباسی‌دوانی؛\u003cbr/\u003e\u003cbr/\u003eمیلیاردها تومان بودجه ساخت سامانه‌های پدافندی بومی چه شد؟\u003cbr/\u003e\u003cbr/\u003eتصاویر جدیدی از اصابت دو بمب به سقف خانه‌ فریدون عباسی‌دوانی، فیزیکدان، رئیس پیشین سازمان انرژی اتمی و نماینده مجلس جمهوری اسلامی منتشر شده است. \u003cbr/\u003e\u003cbr/\u003eفریدون عباسی دوانی، به همراه محسن فخری‌زاده پروژه ساخت سلاح اتمی را پیش می‌بردند.\u003cbr/\u003eبرخی منابع گزارش دادند این هدف با بمب GBU39 SBD با سرجنگی نفوذگر و فیوز تأخیری هدف قرار گرفته است.\u003cbr/\u003eاین بمب احتمالاً از جنگنده‌هایی مثل اف۱۵ یا اف۳۵ شلیک می‌شود.\u003cbr/\u003e\u003cbr/\u003eمنزل عباسی دوانی در همان دقایق نخست جنگ ۱۲ روزه هدف قرار گرفت. \u003cbr/\u003eمحمد محبی تحلیلگر سیاسی و امنیتی با اشاره به این موارد می‌نویسد از اصابت دقیق این هدف و اهداف مشابه پیداست اطلاعات اسرائیل از موقعیت‌ها کافی و هواپیماها بدون مزاحمت وارد عمق آسمان پایتخت ایران شده‌اند‌ و عملیات جنگی انجام داده‌اند و به سلامت به آشیانه‌های خود در اسرائیل بازگشته‌اند.\u003cbr/\u003e\u003cbr/\u003eسایر اهداف نیز کم و بیش به همین ترتیب مورد اصابت قرار گرفته است. محبی اشاره می‌کند: یادتان هست که هر چند ماه یک‌بار از یک سامانه پدافندی با نام‌هایی چون مرصاد، سوم خرداد، عماد، یاور۳۷۳ و... در قالب رزمایش‌هایی با عنوان «مدافعان آسمان ولایت» رونمایی می‌شد؟! کسی هم پرسش نمی‌کرد که مگر ساخت سامانه‌های پدافندی خم رنگرزی است؟! او می‌نویسد برای اجرای این پروژه‌های شکست خورده پدافندی عده‌ای شارلاتان میلیاردها از قبل آن لفت‌ولیس کرده‌اند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF\"\u003e#جنگ\u003c/a\u003e \u003ca href=\"?q=%23%D9%BE%D8%AF%D8%A7%D9%81%D9%86%D8%AF\"\u003e#پدافند\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
