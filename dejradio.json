    {
      "id": 5535,
      "message": "\u003ctg-emoji emoji-id=\"5949286409478082944\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"4911490704376596665\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9191.png\u0026#39;)\"\u003e\u003cb\u003e👑\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e \u003ca href=\"https://x.com/PahlaviReza/status/2064675523440083206?s=20\" target=\"_blank\" rel=\"noopener\" onclick=\"return confirm(\u0026#39;Open this link?\\n\\n\u0026#39;+this.href);\"\u003e شاهزاده رضا پهلوی گفت تیم ملی واقعی ایران، همان مردم ایران است\u003c/a\u003e\u003cbr/\u003e\u003cbr/\u003eشاهزاده رضا پهلوی در آستانۀ آغاز رقابت‌های جام جهانی فوتبال سال 2026 اعلام کرد تیم ملی واقعی ایران، همان مردم ایران است.\u003cbr/\u003eشاهزاده رضا پهلوی همچنین با اشاره به معترضان کشته‌شده، خواستار گرامی‌داشت یاد کسانی شد که امروز آنها نیز باید زنده می‌بودند.\u003cbr/\u003eشاهزاده یک روز مانده به گشایش جام جهانی، با اشاره به این که خودش هم به فوتبال علاقه دارد یادآور شد که جمهوری اسلامی این ورزش را به ابزاری علیه مردم ایران تبدیل کرده است.\u003cbr/\u003eشاهزاده از ایرانیان خواست نشان شیر و خورشید را در ورزشگاه‌، بیرون از آن و در هر جایی که هواداران گردهم می‌آیند، به‌نمایش درآوردند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%B4%D8%A7%D9%87%D8%B2%D8%A7%D8%AF%D9%87_%D8%B1%D8%B6%D8%A7_%D9%BE%D9%87%D9%84%D9%88%DB%8C\"\u003e#شاهزاده_رضا_پهلوی\u003c/a\u003e  \u003ca href=\"?q=%23%D8%AC%D8%A7%D9%85_%D8%AC%D9%87%D8%A7%D9%86%DB%8C\"\u003e#جام_جهانی\u003c/a\u003e \u003ca href=\"?q=%23%D9%81%D9%88%D8%AA%D8%A8%D8%A7%D9%84\"\u003e#فوتبال\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
