    {
      "id": 6311,
      "message": "\u003ctg-emoji emoji-id=\"5949286409478082944\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003cb\u003e دولت عراق برای جلوگیری از انتقال دلار به نیابتی‌های جمهوری اسلامی با آمریکا توافق کرد \u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eوال‌استریت ژورنال به نقل از مقام‌های آمریکایی و عراقی گزارش داد دولت عراق در ازای ازسرگیری ارسال دلار توسط آمریکا، با اعمال محدودیت‌های تازه برای پیشگیری از انتقال دلار به جمهوری اسلامی و گروه‌های نیابتی آن موافقت کرده است.\u003cbr/\u003e\u003cbr/\u003eوزارت خزانه‌داری آمریکا در اوایل جنگ چهل روزه در اسفندماه پیشین، ارسال دلار به عراق را متوقف کرده بود.\u003cbr/\u003eدر آن دوران حملاتی مکرر از سوی نیروهای نیابتی جمهوری اسلامی در عراق به مواضع آمریکا در این کشور، رخ داده بود.\u003cbr/\u003eبر اساس این گزارش، بغداد در چارچوب توافق تازه متعهد شده کنترل‌های مالی را برای جلوگیری از انتقال دلار به جمهوری اسلامی و گروه‌های شبه‌نظامی هم‌پیمان آن تشدید کند.\u003cbr/\u003eاین گزارش در حالی منتشر شده که جنازهٔ علی خامنه‌ای در حال چرخانده ‌شدن در شماری از شهرهای مذهبی شیعیان عراق است.\u003cbr/\u003eاز سویی سخنگوی دولت عراق اعلام کرد گروه‌های شیعهٔ مسلح مورد پشتیبانی حکومت جمهوری اسلامی تا ۳۰ سپتامبر فرصت دارند سلاح‌های خود را تحویل دهند.\u003cbr/\u003eوال‌استریت ژورنال گزارش داد علی زیدی، نخست‌وزیر عراق در روزهای آینده برای گفت‌وگو دربارهٔ روند خلع سلاح گروه‌های نیابتی و ایجاد مانع برای نرسیدن دلار به آنها، به ایالات متحده سفر می‌کند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%B9%D8%B1%D8%A7%D9%82\"\u003e#عراق\u003c/a\u003e \u003ca href=\"?q=%23%D9%86%DB%8C%D8%A7%D8%A8%D8%AA%DB%8C\"\u003e#نیابتی\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%85%D9%87%D9%88%D8%B1%DB%8C_%D8%A7%D8%B3%D9%84%D8%A7%D9%85%DB%8C\"\u003e#جمهوری_اسلامی\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
