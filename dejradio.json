    {
      "id": 5408,
      "message": "\u003ctg-emoji emoji-id=\"5949286409478082944\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e وزیر کشور پاکستان «پاکت ویژۀ مجتبی خامنه‌ای» را به عراقچی تحویل داد\u003cbr/\u003e\u003cbr/\u003eبه گزارش رسانه‌های حکومتی، نامۀ ویژۀ پاکستان برای مجتبی خامنه‌ای، توسط محسن نقوی به عباس عراقچی تحویل داده شد.\u003cbr/\u003e محسن نقوی، وزیر کشور پاکستان که از شامگاه شنبه به ایران وارد شده، مدعی شده بود حامل نامه‌ای ویژه از طرف عاصم منیر، فرماندۀ ارتش پاکستان برای مجتبی خامنه‌ای است.\u003cbr/\u003e وزیر کشور پاکستان پس از ورود به تهران با اسکندر مومنی دیدار کرد.\u003cbr/\u003e مقام پاکستانی اعلام کرد پیام دیگری نیز از طرف شهباز شریف، نخست‌وزیر پاکستان برای رهبر تازه اعلام شدۀ جمهوری اسلامی آورده‌ است.\u003cbr/\u003e پاکستان در ماه‌های اخیر نقش میانجی اصلی میان جمهوری اسلامی و آمریکا را بر عهده گرفته است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AE%D8%A8%D8%B1\"\u003e#خبر\u003c/a\u003e \u003ca href=\"?q=%23%D8%AF%DA%98\"\u003e#دژ\u003c/a\u003e \u003ca href=\"?q=%23%D9%85%D8%B0%D8%A7%DA%A9%D8%B1%D8%A7%D8%AA\"\u003e#مذاکرات\u003c/a\u003e \u003ca href=\"?q=%23%D9%BE%D8%A7%DA%A9%D8%B3%D8%AA%D8%A7%D9%86\"\u003e#پاکستان\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
