    {
      "id": 7584,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F8EA5.png\u0026#39;)\"\u003e\u003cb\u003e🎥\u003c/b\u003e\u003c/i\u003e اعتبار ریال در ایران آنقدر نزول کرده که عملا تبدیل به یک پول بی‌اعتبار، و به مضحکه مردم تبدیل شده است. \u003cbr/\u003e\u003cbr/\u003eیکی از مخاطبان با ارسال ویدیویی نوشت: بی‌اعتباری ریال یعنی نابودی زندگی، درست مانند ارزش صفر پول‌های کشورهای بیچاره‌ با حکومت‌های فشل و فاسد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%B1%DB%8C%D8%A7%D9%84\"\u003e#ریال\u003c/a\u003e \u003ca href=\"?q=%23%D8%A7%D8%B1%D8%B2%D8%B4_%D9%BE%D9%88%D9%84\"\u003e#ارزش_پول\u003c/a\u003e \u003ca href=\"?q=%23%D9%81%D8%B3%D8%A7%D8%AF\"\u003e#فساد\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
