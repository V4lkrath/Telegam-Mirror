    {
      "id": 6436,
      "message": "\u003ctg-emoji emoji-id=\"5949286409478082944\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e  \u003ca href=\"https://truthsocial.com/@realDonaldTrump/116913091653271692\" target=\"_blank\" rel=\"noopener\" onclick=\"return confirm(\u0026#39;Open this link?\\n\\n\u0026#39;+this.href);\"\u003e\u003cb\u003eترامپ: محاصرۀ دریایی جمهوری اسلامی دوباره برقرار می‌شود؛ آمریکا «نگهبان تازۀ» تنگۀ هرمز \u003c/b\u003e\u003c/a\u003e\u003cbr/\u003e\u003cbr/\u003eدونالد ترامپ، رئیس‌ جمهوری آمریکا عصر دوشنبه ۲۲ تیرماه اعلام کرد ایالات متحده بار دیگر محاصرۀ دریایی را علیه جمهوری اسلامی  برقرار می‌کند.\u003cbr/\u003eترامپ اعلام کرد امکانات و تجهیزات لازم برای برقراری محاصرۀ بنادر جنوبی ایران، بی‌درنگ مهیا می‌شود.\u003cbr/\u003eترامپ در شبکۀ اجتماعی تروث، نوشت تنگۀ هرمز «با یا بدون {رژیم حاکم بر} ایران» بازمی‌ماند و آمریکا از این پس به عنوان «نگهبان تنگۀ هرمز» شناخته می‌شود.\u003cbr/\u003eاو همچنین اعلام کرد واشینگتن برای تأمین امنیت این آبراه، ۲۰ درصد از ارزش همۀ محموله‌های عبوری را به عنوان هزینه دریافت می‌کند.\u003cbr/\u003eترامپ تأکید کرد محاصرۀ دریایی تنها کشتی‌ها و مشتریان جمهوری اسلامی را هدف قرار می‌دهد و سایر کشورها همچنان به امکان تردد آزادانه از تنگۀ هرمز دسترسی پیدا می‌کنند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AA%D9%86%DA%AF%D9%87_%D9%87%D8%B1%D9%85%D8%B2\"\u003e#تنگه_هرمز\u003c/a\u003e \u003ca href=\"?q=%23%D9%85%D8%AD%D8%A7%D8%B5%D8%B1%D9%87_%D8%AF%D8%B1%DB%8C%D8%A7%DB%8C%DB%8C\"\u003e#محاصره_دریایی\u003c/a\u003e \u003ca href=\"?q=%23%D8%AA%D8%B1%D8%A7%D9%85%D9%BE\"\u003e#ترامپ\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
