    {
      "id": 146896,
      "message": "\u003cb\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29C85.png\u0026#39;)\"\u003e\u003cb\u003e✅\u003c/b\u003e\u003c/i\u003eاین خبر هم نارضایتی شدید چین از ایران بخاطر بستن تنگه هرمز، تلاش برای گرفتن عوارض از تنگه هرمز و حمله به کشورهای عربیِ میزبانِ سرمایه گذاریهایِ چین را نشان میدهد.\u003c/b\u003e\u003cbr/\u003e\u003cb\u003eرهبران چین فعلا به شدت از دست ایران عصبانی هستند و به هیچ عنوان حاضر به ملاقات رسمی در سطوح بالا نیستند.\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003e\u003cb\u003eچند روز پیش، رییس سازمان برنامه دولت رییسی گفته بود خرید نفت ایران توسط چین به روزی 540 هزار بشکه رسیده است در حالی که تا قبل از بستن تنگه هرمز، چین روزانه سه برابر این مقدار از ما نفت میخرید.\u003c/b\u003e\u003cbr/\u003e\u003cb\u003eبه عبارت دیگر، چین در اعتراض به بستن تنگه هرمز، راسا دست به تحریم نفتی ایران زده است.\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Sahamnewsorg\" target=\"_blank\"\u003e\u003cb\u003e@Sahamnewsorg\u003c/b\u003e\u003c/a\u003e",
