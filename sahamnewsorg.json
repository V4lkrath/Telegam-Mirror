    },
    {
      "id": 144437,
      "message": "\u003cb\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29C85.png\u0026#39;)\"\u003e\u003cb\u003e✅\u003c/b\u003e\u003c/i\u003eحمله آمریکا به ۳۰۰ هدف در ۳ شب / تنگه هرمز باز شد\u003cbr/\u003e\u003c/b\u003e\u003cbr/\u003eفرماندهی مرکزی آمریکا می‌گوید در سه شب بیش از ۳۰۰ هدف نظامی در ایران را مورد حمله قرار داده است. در مقابل، سپاه از هدف قرار دادن مواضع آمریکا در اردن، کویت، عمان و قطر خبر داده و اعلام کرده تنگه هرمز تا پایان دخالت واشنگتن در منطقه بسته می‌ماند؛ با این حال، سنتکام می‌گوید عبور کشتی‌های تجاری همچنان ادامه دارد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Sahamnewsorg\" target=\"_blank\"\u003e@Sahamnewsorg\u003c/a\u003e",
      "date": "2026-07-12T17:38:34Z",
