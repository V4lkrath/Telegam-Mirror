    },
    {
      "id": 147222,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29C85.png\u0026#39;)\"\u003e\u003cb\u003e✅\u003c/b\u003e\u003c/i\u003eدلار از ۲۳۰ هزار تومان گذشت\u003cbr/\u003e\u003cbr/\u003eدر پی افزایش دوباره تنش‌های نظامی در خاورمیانه، قیمت دلار در بازار آزاد ایران، از ۲۳۰ هزار تومان گذشت. در همین راستا، یورو به ۲۷۰ هزار تومان و پوند بریتانیا به ۳۱۱ هزار تومان رسید.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Sahamnewsorg\" target=\"_blank\"\u003e@Sahamnewsorg\u003c/a\u003e",
      "date": "2026-09-09T08:46:40Z",
