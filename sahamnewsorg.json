    {
      "id": 141830,
      "message": "\u003cb\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29C85.png\u0026#39;)\"\u003e\u003cb\u003e✅\u003c/b\u003e\u003c/i\u003eسناریوهای حمله احتمالی آمریکا و بازیابی توان نظامی در ایران \u003cbr/\u003e\u003c/b\u003e\u003cbr/\u003eروزنامه نیویورک‌تایمز  گزارش داد آمریکا و اسرائیل وارد مرحله فشرده آماده‌سازی نظامی برای احتمال ازسرگیری حملات به ایران شده‌اند.\u003cbr/\u003e\u003cbr/\u003eبر اساس این گزارش، سناریوهای مورد بررسی شامل حملات هوایی گسترده به اهداف نظامی و زیرساختی، عملیات ویژه برای دسترسی به مواد هسته‌ای در تأسیسات اصفهان و نیز احتمال حمله برای تصرف جزیره خارک است.\u003cbr/\u003e\u003cbr/\u003eبه نوشته نیویورک‌تایمز، آمریکا در حال حاضر حدود ۵ هزار نیروی تفنگدار دریایی، ۲ هزار نیروی لشکر ۸۲ هوابرد، دو ناوگروه هواپیمابر، ده‌ها ناوشکن و صدها جنگنده در منطقه مستقر کرده است.\u003cbr/\u003e\u003cbr/\u003eاین گزارش همچنین به ارزیابی‌های اطلاعاتی آمریکا اشاره می‌کند که بر اساس آن ایران پس از جنگ اخیر، همچنان به ۳۰ مورد از ۳۳ پایگاه اصلی موشکی خود دسترسی عملیاتی دارد، حدود ۷۰ درصد پرتابگرهای متحرک و موشک‌های بالستیک خود را حفظ کرده و ۹۰ درصد پناهگاه‌های زیرزمینی‌اش همچنان فعال هستند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Sahamnewsorg\" target=\"_blank\"\u003e@Sahamnewsorg\u003c/a\u003e",
      "date": "2026-05-16T18:40:22Z",
      "edited": false,
      "edit_date": "0001-01-01T00:00:00Z",
      "views": 21500,
      "forwards": 0,
