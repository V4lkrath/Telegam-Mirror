    },
    {
      "id": 142944,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29C85.png\u0026#39;)\"\u003e\u003cb\u003e✅\u003c/b\u003e\u003c/i\u003eسی‌ان‌ان به نقل از یک منبع دیپلماتیک گزارش داد مذاکرات آمریکا و ایران برای دستیابی به توافق همچنان ادامه دارد.\u003cbr/\u003e\u003cbr/\u003eبر اساس این گزارش، گفت‌وگوها با وجود حملات آمریکا به ایران و حملات متقابل ایران به اهداف آمریکایی در خاورمیانه، همچنان در جریان است.\u003cbr/\u003e\u003cbr/\u003eهمچنین سه منبع ایرانی به «رویترز» گفتند تلاش‌ها برای رسیدن به یک توافق اولیه میان تهران و واشینگتن به‌رغم حملات دو طرف، افزایش یافته است. این منابع افزودند که دو طرف در حال بررسی سازوکاری برای آزادسازی دارایی‌های بلوکه‌شده ایران هستند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Sahamnewsorg\" target=\"_blank\"\u003e@Sahamnewsorg\u003c/a\u003e",
      "date": "2026-06-11T10:51:30Z",
