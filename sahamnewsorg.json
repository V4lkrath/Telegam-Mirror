    {
      "id": 145470,
      "message": "\u003cb\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29C85.png\u0026#39;)\"\u003e\u003cb\u003e✅\u003c/b\u003e\u003c/i\u003eدبیر انجمن واردکنندگان فرآورده های خام دامی: براساس آمار در ۴ ماهه امسال ۱۵ هزار تن گوشت قرمز وارد شده که نسبت به مدت مشابه سال قبل ۵۰ درصد کاهش یافته است\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Sahamnewsorg\" target=\"_blank\"\u003e\u003cb\u003e@Sahamnewsorg\u003c/b\u003e\u003c/a\u003e",
