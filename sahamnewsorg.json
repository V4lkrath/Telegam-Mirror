    {
      "id": 144026,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29C85.png\u0026#39;)\"\u003e\u003cb\u003e✅\u003c/b\u003e\u003c/i\u003eیکی از موکب‌هاشون در مصلی روزانه ۵۰ هزار غذا توزیع می کند\u003cbr/\u003e\u003cbr/\u003e‎هزینه جشن های ۲۵۰۰ ساله کجا و ریخت و پاش این روزها کجا\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Sahamnewsorg\" target=\"_blank\"\u003e@Sahamnewsorg\u003c/a\u003e",
