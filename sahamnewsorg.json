    {
      "id": 146671,
      "message": "\u003cb\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29C85.png\u0026#39;)\"\u003e\u003cb\u003e✅\u003c/b\u003e\u003c/i\u003eنرخ سوم قیمت بنزین بیش از ۱۰ هزار تومان نخواهد شد\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003e\u003cb\u003eرئیس‌جمهور با تکذیب افزایش نجومی قیمت بنزین\u003c/b\u003e:\u003cbr/\u003e\u003cbr/\u003eفقط نرخ سوم قیمت بنزین پس از هماهنگی با همه نهادها و ارگان‌ها از ۵ هزار تومان به ۱۰ هزار تومان خواهد رسید. نرخ سوم قیمت بنزین بیش از ۱۰ هزار تومان نخواهد شد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Sahamnewsorg\" target=\"_blank\"\u003e@Sahamnewsorg\u003c/a\u003e",
      "date": "2026-08-28T19:18:17Z",
      "edited": false,
      "edit_date": "0001-01-01T00:00:00Z",
      "views": 40400,
      "forwards": 0,
      "replies": 0,
