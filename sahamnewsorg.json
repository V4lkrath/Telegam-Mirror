    {
      "id": 143399,
      "message": "\u003cb\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29C85.png\u0026#39;)\"\u003e\u003cb\u003e✅\u003c/b\u003e\u003c/i\u003eپس از ۸۰ دقیقه مذاکره، نشست چهار جانبه ایران و امریکا با حضور میانجیگران پاکستانی و قطری جهت تنفس و مشورت‌های داخلی متوقف شد\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Sahamnewsorg\" target=\"_blank\"\u003e@Sahamnewsorg\u003c/a\u003e",
