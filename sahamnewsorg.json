    {
      "id": 147009,
      "message": "\u003cb\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29C85.png\u0026#39;)\"\u003e\u003cb\u003e✅\u003c/b\u003e\u003c/i\u003eپرواز قیمت دارو در یک سال\u003c/b\u003e\u003cbr/\u003e\u003cb\u003eآموکسی‌سیلین از ۳۲۰ هزار تومان به ۱.۲ میلیون رسید\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003e\u003cb\u003eگاباپنتن ۳۰۰ در شهریور ۱۴۰۴، ۳۰۰ هزار تومان بوده و در شهریور ۱۴۰۵، به ۹۶۰ هزار تومان رسیده است.\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003e\u003cb\u003eقیمت استامینوفن کدئین از ۱۳۷ هزار تومان، به ۶۵۰ هزار تومان افزایش یافته است.\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003e\u003cb\u003eفلوکستین ۲۰ از ۱۷۵ هزار تومان به ۳۵۰ هزار تومان رسیده است.\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003e\u003cb\u003eایبوپروفن از ۲۰۰ هزار تومان به ۴۲۰ هزار تومان افزایش قیمت داشته است.\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003e\u003cb\u003eاسویکس از ۹۷ هزار و ۸۰۰ تومان به ۳۰۰ هزار تومان رسیده است.\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003e\u003cb\u003eآموکسی سیلین از ۳۲۰ هزار تومان به یک میلیون و ۲۳۰ هزار تومان، رسیده است.\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003e\u003cb\u003eقرص کلاریترومایسین از ۴۵۰ هزار تومان، به یک میلیون و ۵۸۰ هزار تومان رسیده است./اقتصادنیوز\u003c/b\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Sahamnewsorg\" target=\"_blank\"\u003e\u003cb\u003e@Sahamnewsorg\u003c/b\u003e\u003c/a\u003e",
