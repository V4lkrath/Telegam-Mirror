    {
      "id": 145160,
      "message": "\u003cb\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29C85.png\u0026#39;)\"\u003e\u003cb\u003e✅\u003c/b\u003e\u003c/i\u003eسخنگوی سپاه: انگلیس در صورت همراهی با آمریکا هدف قطعی و مشروع ما خواهد بود\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eمحبی سخنگوی سپاه همچنین  ادعا کرد تعداد کشته‌های آمریکا بعد از نقض تفاهمنامه بالای 200 نفر است!!\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Sahamnewsorg\" target=\"_blank\"\u003e@Sahamnewsorg\u003c/a\u003e",
