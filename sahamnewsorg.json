    {
      "id": 145273,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29C85.png\u0026#39;)\"\u003e\u003cb\u003e✅\u003c/b\u003e\u003c/i\u003eادعای خبرگزاری تسنیم وابسته به سپاه: بر اساس نظرسنجی‌ها، ۷۷.۵% مردم موافق حفظ کنترل تنگه هرمز هستند حتی اگر منجر به جنگ شود\u003cbr/\u003e\u003cbr/\u003e۷۵ درصد مردم خواهان کشتن ترامپ و نتانیاهو هستند!!!\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Sahamnewsorg\" target=\"_blank\"\u003e@Sahamnewsorg\u003c/a\u003e",
