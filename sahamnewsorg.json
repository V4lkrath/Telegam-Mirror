    {
      "id": 145566,
      "message": "\u003cb\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29C85.png\u0026#39;)\"\u003e\u003cb\u003e✅\u003c/b\u003e\u003c/i\u003eبلومبرگ:عربستان برای نجات نفت خود با حوثی‌ها پنهانی مذاکره می‌کند\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003e\u003cb\u003eعربستان سعودی در تلاش است تا از طریق دیپلماسی پنهان، درگیری مجدد با حوثی‌ها (انصارالله) را کنترل کند تا از صنایع نفت و اقتصاد خود محافظت نماید\u003c/b\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Sahamnewsorg\" target=\"_blank\"\u003e@Sahamnewsorg\u003c/a\u003e",
