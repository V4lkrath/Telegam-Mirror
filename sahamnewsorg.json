      "edit_date": "0001-01-01T00:00:00Z",
      "views": 27700,
      "forwards": 0,
      "replies": 0,
      "sender_id": 0,
      "sender_name": "سهام نیوز"
    },
    {
      "id": 146701,
      "message": "\u003cb\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29C85.png\u0026#39;)\"\u003e\u003cb\u003e✅\u003c/b\u003e\u003c/i\u003eخرید یک کیلو گوشت، ۱۴ درصد حقوق مردم را می‌بلعد!\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eبا حقوق پایه ۱۶ میلیون تومانی و قیمت حدود ۲.۳ میلیون تومان برای هر کیلو گوشت خورشتی، خرید تنها یک کیلو گوشت به بیش از ۱۴ درصد حقوق ماهانه یک کارگر می‌رسد.\u003cbr/\u003e\u003cbr/\u003eافزایش قیمت گوشت باعث شده بسیاری از خانوارها برای کاهش هزینه‌های زندگی، مصرف آن را محدود یا حذف کنند؛ تا جایی که غذاهای سنتی مانند قورمه‌سبزی، قیمه و آبگوشت نیز در برخی سفره‌ها بدون گوشت پخته می‌شوند.\u003cbr/\u003e\u003cbr/\u003eتداوم تورم در بازار مواد غذایی، علاوه بر کاهش قدرت خرید خانوارها، به تدریج الگوی مصرف و سبک زندگی مردم را نیز تغییر داده و برخی از غذاهای محبوب و سنتی ایرانی را از سفره خانواده‌ها دور کرده است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Sahamnewsorg\" target=\"_blank\"\u003e@Sahamnewsorg\u003c/a\u003e",
