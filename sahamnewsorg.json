    },
    {
      "id": 146759,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29C85.png\u0026#39;)\"\u003e\u003cb\u003e✅\u003c/b\u003e\u003c/i\u003eخبرگزاری تسنیم، رسانه وابسته به سپاه، گزارش داد که ساعتی پیش حمله پهپادی به جزیره لارک در استان هرمزگان انجام شد.\u003cbr/\u003e\u003cbr/\u003eتسنیم نوشت که برخی گزارش‌های اولیه غیررسمی حاکی است که بر اثر حمله آمریکا تاکنون ۲ نفر کشته شده و ۲ نفر نیز مجروح شده‌اند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Sahamnewsorg\" target=\"_blank\"\u003e@Sahamnewsorg\u003c/a\u003e",
