      "views": 14400,
      "forwards": 0,
      "replies": 0,
      "sender_id": 0,
      "sender_name": "سهام نیوز"
    },
    {
      "id": 145016,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29C85.png\u0026#39;)\"\u003e\u003cb\u003e✅\u003c/b\u003e\u003c/i\u003eصداوسیما بامداد پنجشنبه از شنیده شدن صدای چند انفجار در بخش بمانی و اطراف روستای زیارت در شهرستان سیریک خبر داد.\u003cbr/\u003eهمزمان، صداوسیما گزارش داد صداهای مهیب شبیه انفجار در اهواز شنیده شده و همچنین از وقوع انفجار در رامشیر خبر داد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Sahamnewsorg\" target=\"_blank\"\u003e@Sahamnewsorg\u003c/a\u003e",
      "date": "2026-07-22T21:05:29Z",
