    {
      "id": 143367,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29C85.png\u0026#39;)\"\u003e\u003cb\u003e✅\u003c/b\u003e\u003c/i\u003eبلای جان ایران اختلاس است‌\u003cbr/\u003e\u003cbr/\u003eسعید لیلاز:ارز گمشده از سال ۹۷ تا به امروز ۲۰۰ میلیارد دلار.\u003cbr/\u003e\u003cbr/\u003eاختلاس سیستم بانکی سالی ۴۰میلیارد دلار!\u003cbr/\u003e\u003cbr/\u003eخسارت فولاد در جنگ ۳ میلیارد دلار.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Sahamnewsorg\" target=\"_blank\"\u003e@Sahamnewsorg\u003c/a\u003e",
