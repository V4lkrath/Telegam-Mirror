    {
      "id": 146230,
      "message": "\u003cb\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29C85.png\u0026#39;)\"\u003e\u003cb\u003e✅\u003c/b\u003e\u003c/i\u003eسنگاپور قدرتمندترین گذرنامه جهان از نظر آزادی سفر\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eسنگاپور با امکان سفر به ۱۹۲ مقصد بدون نیاز به دریافت ویزا پیش از سفر، در صدر رتبه‌بندی گذرنامه‌های جهان قرار دارد.\u003cbr/\u003e\u003cbr/\u003eژاپن، کره‌جنوبی و امارات با دسترسی بدون ویزای قبلی به ۱۸۸ مقصد در رتبه‌های بعدی قرار گرفته‌اند.\u003cbr/\u003e\u003cbr/\u003eدر سوی دیگر، گذرنامه افغانستان تنها امکان دسترسی به ۲۲ مقصد را بدون ویزای قبلی فراهم می‌کند؛ به این ترتیب فاصله میان قدرتمندترین و ضعیف‌ترین گذرنامه در این شاخص به ۱۷۰ مقصد می‌رسد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Sahamnewsorg\" target=\"_blank\"\u003e@Sahamnewsorg\u003c/a\u003e",
      "date": "2026-08-19T07:34:38Z",
