    {
      "id": 144426,
      "message": "\u003cb\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29C85.png\u0026#39;)\"\u003e\u003cb\u003e✅\u003c/b\u003e\u003c/i\u003eحکایت بستن تنگه هرمز، حکایت آن چاه‌کنی است که حقوق می‌گرفت در بیابان کلنگ بزند ولی آبی در کار نبود.\u003cbr/\u003eبستن تنگه هم برای ایران آب ندارد؛ اما میلیاردها دلار روانه خزانه دولت روسیه می‌کند.\u003cbr/\u003e\u003cbr/\u003e\u003c/b\u003e\u003ca href=\"https://t.me/Sahamnewsorg\" target=\"_blank\"\u003e\u003cb\u003e@Sahamnewsorg\u003c/b\u003e\u003c/a\u003e",
