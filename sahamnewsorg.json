    {
      "id": 141749,
      "message": "\u003cb\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29C85.png\u0026#39;)\"\u003e\u003cb\u003e✅\u003c/b\u003e\u003c/i\u003eتصاویر تکان‌دهنده از ایالت اوتار پرادش هند؛ در پی وزش بادهای شدید و کنده شدن یک سقف فلزی در جریان طوفان، جوانی به همراه سازه به هوا پرتاب شد.\u003cbr/\u003e\u003cbr/\u003eطوفان در هند ۹۰ کشته بر جای گذاشت \u003cbr/\u003e\u003cbr/\u003eپس از طوفان شدید که باران شدید، تگرگ و رعد و برق را به همراه داشت، حداقل ۹۰ نفر در اوتار پرادش، پرجمعیت‌ترین ایالت هند، کشته و ۵۳ نفر دیگر زخمی شدند.\u003cbr/\u003e\u003cbr/\u003e\u003c/b\u003e\u003ca href=\"https://t.me/Sahamnewsorg\" target=\"_blank\"\u003e\u003cb\u003e@Sahamnewsorg\u003c/b\u003e\u003c/a\u003e",
