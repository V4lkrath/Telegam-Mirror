      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29C85.png\u0026#39;)\"\u003e\u003cb\u003e✅\u003c/b\u003e\u003c/i\u003e‌پارلمان لبنان مجازات ⁧ \u003ca href=\"?q=%23%D8%A7%D8%B9%D8%AF%D8%A7%D9%85\"\u003e#اعدام\u003c/a\u003e ⁩ را لغو کرد.\u003cbr/\u003e‏پارلمان ما هم برای استفاده از تکنولوژی روز دنیا ⁧ \u003ca href=\"?q=%23%D8%A7%D8%B3%D8%AA%D8%A7%D8%B1%D9%84%DB%8C%D9%86%DA%A9\"\u003e#استارلینک\u003c/a\u003e ⁩ مجازات تا اعدام مصوب کرد.\u003cbr/\u003e‏باز نشدن چنین مجلسی ام را آرزوست./بهرام پارسایی نماینده سابق مجلس\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Sahamnewsorg\" target=\"_blank\"\u003e@Sahamnewsorg\u003c/a\u003e",
