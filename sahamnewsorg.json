    {
      "id": 142861,
      "message": "\u003cb\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29C85.png\u0026#39;)\"\u003e\u003cb\u003e✅\u003c/b\u003e\u003c/i\u003eقطع آب ۲۰ هزار نفر در حمله موشکی آمریکا به مخازن بمانی\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eمدیرعامل شرکت آبفا هرمزگان:\u003cbr/\u003e\u003cbr/\u003eبامداد امروز، در اقدامی غیرانسانی، دو مخزن بتنی ذخیره آب با ظرفیت مجموع ۲۵۰۰ مترمکعب در بخش بمانی هدف اصابت موشک قرار گرفت و به طور کامل از مدار بهره‌برداری خارج شد.\u003cbr/\u003e\u003cbr/\u003eاین مخازن که از پروژه‌های کلیدی آبرسانی محسوب می‌شدند، وظیفه تأمین آب شرب شهر کوهستک و ۱۰ روستای اطراف را بر عهده داشتند متأسفانه در پی این حمله، دسترسی ۲۰ هزار نفر از مردم شریف این منطقه به آب سالم قطع شده و با توجه به دمای هوای ۴۵ تا ۵۰ درجه، شرایط برای ساکنان این بخش بسیار دشوار و بحرانی شده است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Sahamnewsorg\" target=\"_blank\"\u003e@Sahamnewsorg\u003c/a\u003e",
      "date": "2026-06-10T08:06:12Z",
      "edited": false,
      "edit_date": "0001-01-01T00:00:00Z",
      "views": 41500,
      "forwards": 0,
      "replies": 0,
      "sender_id": 0,
      "sender_name": "سهام نیوز"
    },
