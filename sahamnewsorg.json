      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29C85.png\u0026#39;)\"\u003e\u003cb\u003e✅\u003c/b\u003e\u003c/i\u003eشعار شب گذشته شب گردها \u003cbr/\u003e\u003cbr/\u003eتو تاریکی می‌شینیم، ذلت نمی‌پذیریم.\u003cbr/\u003eبنزین رو کم میگیریم، ذلت نمی‌پذیریم.\u003cbr/\u003eدلاری گوشت میگیریم، ذلت نمی‌پذیریم.\u003cbr/\u003eمهریه کم میگیریم، ذلت نمی پذیریم.\u003cbr/\u003eآورین آورین\u003cbr/\u003e\u003ca href=\"https://t.me/Sahamnewsorg\" target=\"_blank\"\u003e@Sahamnewsorg\u003c/a\u003e",
