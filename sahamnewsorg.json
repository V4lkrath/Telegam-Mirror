    {
      "id": 142403,
      "message": "\u003cb\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29C85.png\u0026#39;)\"\u003e\u003cb\u003e✅\u003c/b\u003e\u003c/i\u003eروزنامه خراسان نزدیک به رئیس مجلس: بعید است مذاکرات ایران و امریکا به نتیجه برسد/ جنگ فعلا ادامه دارد\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Sahamnewsorg\" target=\"_blank\"\u003e@Sahamnewsorg\u003c/a\u003e",
      "date": "2026-05-31T07:18:57Z",
