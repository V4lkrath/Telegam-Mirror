    {
      "id": 142640,
      "message": "\u003cb\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29C85.png\u0026#39;)\"\u003e\u003cb\u003e✅\u003c/b\u003e\u003c/i\u003eسقاب اصفهانی معاون انرژی رئیس جمهور:\u003cbr/\u003e\u003cbr/\u003eپارسال کسری انرژی مون ۴۵ میلیارد متر مکعب بود\u003cbr/\u003eدر جنگ ۴۰ روزه ۵۵ میلیارد متر مکعب نیز از بین رفت.\u003cbr/\u003eبا کسری ۱۰۰ میلیارد متر مکعبی گاز رو برو میشیم\u003cbr/\u003e\u003cbr/\u003e\u003c/b\u003e\u003ca href=\"https://t.me/Sahamnewsorg\" target=\"_blank\"\u003e\u003cb\u003e@Sahamnewsorg\u003c/b\u003e\u003c/a\u003e",
