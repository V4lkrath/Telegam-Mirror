    },
    {
      "id": 145930,
      "message": "‏\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29C85.png\u0026#39;)\"\u003e\u003cb\u003e✅\u003c/b\u003e\u003c/i\u003e۱۳.۵ میلیون خانوار ایرانی ⁧ \u003ca href=\"?q=%23%D8%AE%D9%88%D8%AF%D8%B1%D9%88\"\u003e#خودرو\u003c/a\u003e ⁩ ندارند؛ در مقابل، ۴ میلیون خانوار مالک ۱۶ میلیون خودرو هستند. این فقط آمار مالکیت خودرو نیست؛ تصویر روشنی از شکاف دارایی و نابرابری توزیع ثروت در ⁧ \u003ca href=\"?q=%23%D8%A7%D9%82%D8%AA%D8%B5%D8%A7%D8%AF\"\u003e#اقتصاد\u003c/a\u003e ⁩ ایران است.\u003cbr/\u003e‏خودرو برای بخشی «دارایی» است و برای نیمی از خانوارها حتی در دسترس نیست.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Sahamnewsorg\" target=\"_blank\"\u003e@Sahamnewsorg\u003c/a\u003e",
