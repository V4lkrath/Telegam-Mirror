    },
    {
      "id": 146513,
      "message": "\u003cb\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29C85.png\u0026#39;)\"\u003e\u003cb\u003e✅\u003c/b\u003e\u003c/i\u003eالحدث، نزدیک به عربستان، می‌گوید عاصم منیر، فرمانده ارتش پاکستان، دیروز در دیدار با محسن رضایی، دبیر شورای عالی امنیت ملی، این پیشنهاد آمریکا را ارائه داده: بازگشایی تنگه هرمز و پایان حمله‌های گروه‌های نزدیک به ایران، در ازای رفع محاصره دریایی و رفع تحریم‌ها براساس یک تفاهم‌نامه.\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003eگویا طرف پاکستانی صریحا گفته هم آمریکا مسوول شکست خوردن تفاهم‌نامه پاکستان است و هم جمهوری اسلامی.\u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003eطرف ایرانی اعلام کرده در روزهای آینده پاسخ  می‌دهد و گویا رئيس‌جمهوری اسلامی، مسعود پزشکیان، ونخست‌وزیر پاکستان در چارچوب نشست رهبران پیمان شانگهای، هفته آینده دیدار می‌کنند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Sahamnewsorg\" target=\"_blank\"\u003e@Sahamnewsorg\u003c/a\u003e",
