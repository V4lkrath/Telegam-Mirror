    {
      "id": 142943,
      "message": "\u003cb\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29C85.png\u0026#39;)\"\u003e\u003cb\u003e✅\u003c/b\u003e\u003c/i\u003eحمله آمریکا به یک لنج باری متعلق به اهالی سیریک در دریای عمان\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eلحظاتی قبل از غرق‌شدن لنج ۱۵۰ تنی سیریک هرمزگان در پی حمله آمریکا؛ ملوانان با کمک قایق‌‌های عبوری نجات یافتند\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Sahamnewsorg\" target=\"_blank\"\u003e@Sahamnewsorg\u003c/a\u003e",
      "date": "2026-06-11T10:45:00Z",
