    {
      "id": 144732,
      "message": "\u003cb\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29C85.png\u0026#39;)\"\u003e\u003cb\u003e✅\u003c/b\u003e\u003c/i\u003eفغانی برای داوری فینال جام جهانی انتخاب نشد \u003cbr/\u003e\u003c/b\u003e\u003cbr/\u003e\u003cb\u003eفیفا اسلاوکو وینچیچ، داور اسلوونیایی، را به‌عنوان داور فینال جام جهانی انتخاب کرد.\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Sahamnewsorg\" target=\"_blank\"\u003e@Sahamnewsorg\u003c/a\u003e",
