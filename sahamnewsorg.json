    },
    {
      "id": 146760,
      "message": "\u003cb\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29C85.png\u0026#39;)\"\u003e\u003cb\u003e✅\u003c/b\u003e\u003c/i\u003eآغاز دور جدید درگیری نظامی در خاورمیانه،\u003c/b\u003e\u003cbr/\u003e\u003cb\u003eهم اکنون سپاه اعلام کرد:\u003c/b\u003e\u003cbr/\u003e\u003cb\u003eبه زودی به حمله آمریکا پاسخ خواهیم داد و آمریکا را به شدت مجازات خواهیم کرد.\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Sahamnewsorg\" target=\"_blank\"\u003e\u003cb\u003e@Sahamnewsorg\u003c/b\u003e\u003c/a\u003e",
