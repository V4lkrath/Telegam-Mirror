    },
    {
      "id": 146628,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29C85.png\u0026#39;)\"\u003e\u003cb\u003e✅\u003c/b\u003e\u003c/i\u003eایران از ابتدای سال ۲۰۲۶ تاکنون بیش از ۵۰۰ نفر را اعدام کرده است\u003cbr/\u003e\u003cbr/\u003eسازمان حقوق بشر ایران می‌گوید با افزایش اعدام‌ها در روزهای اخیر، بیش از ۵۰۰ نفر از ابتدای سال جاری میلادی تاکنون در ایران اعدام شده‌اند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Sahamnewsorg\" target=\"_blank\"\u003e@Sahamnewsorg\u003c/a\u003e",
