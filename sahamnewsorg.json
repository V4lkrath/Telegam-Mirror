    {
      "id": 141859,
      "message": "\u003cb\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29C85.png\u0026#39;)\"\u003e\u003cb\u003e✅️\u003c/b\u003e\u003c/i\u003e رسانه ها از حمله پیش‌ دستانه پهپادی به نيروگاه براكه امارات خبر می‌دهند \u003cbr/\u003e\u003cbr/\u003eدر پي اين حمله آتش سوزي در يك ژنراتور برق به وقوع پيوست\u003cbr/\u003e\u003cbr/\u003e\u003c/b\u003e\u003ca href=\"https://t.me/Sahamnewsorg\" target=\"_blank\"\u003e\u003cb\u003e@Sahamnewsorg\u003c/b\u003e\u003c/a\u003e",
